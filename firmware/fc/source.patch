+  trace[1] = s->sequence;
+  trace[2] = now;
+  trace[3] = targetPidLooptime;
+  trace[4] = dt;
+  trace[5] = (observed ? 1 : 0) | (allocated ? 2 : 0) | (servo ? 4 : 0) |
