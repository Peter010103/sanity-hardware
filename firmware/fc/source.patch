+  trace[16] = paper.voltageSupport;
+  trace[17] = SP_NATIVE_MODEL;
+  trace[18] = native.accepted.session;
+  trace[19] = native.accepted.sequence;
+  trace[20] = native.consumedSession;
+  trace[21] = native.consumedSequence;
