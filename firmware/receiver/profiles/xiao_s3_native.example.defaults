# Sanitized XIAO ESP32-S3 / PIN1 + SZC6 template. Supply your own network credentials.
CONFIG_SANITY_PAPER_NATIVE=y
CONFIG_SANITY_ESTIMATOR_EXPERIMENT=y
CONFIG_SANITY_MOCAP_CLOCK_UDP_PORT=7461
CONFIG_SANITY_MOCAP_STREAM=y
# CONFIG_SANITY_RAW_UDP is not set
CONFIG_SANITY_DATAGRAM_HOST="10.0.0.200"
CONFIG_SANITY_DATAGRAM_PORT=7451
CONFIG_SANITY_DATAGRAM_HOST_PORT=7450
CONFIG_SANITY_DIAGNOSTIC_LEVEL=1
# CONFIG_SANITY_MSP_TUNING is not set
CONFIG_SANITY_TIMING_DIAGNOSTICS=y
# CONFIG_SANITY_COMMS_TEST_ONLY is not set
CONFIG_SANITY_COMMAND_TIMING_TRACE=y
# CONFIG_SANITY_SPLIT_TELEMETRY is not set
CONFIG_SANITY_DEVICE_ID=15
CONFIG_SANITY_WIFI_SSID="CHANGE_ME"
CONFIG_SANITY_WIFI_PASSWORD="CHANGE_ME"
CONFIG_SANITY_STATIC_IP=y
CONFIG_SANITY_IPV4_ADDRESS="10.0.0.115"
CONFIG_SANITY_IPV4_NETMASK="255.255.255.0"
CONFIG_SANITY_IPV4_GATEWAY="10.0.0.1"
CONFIG_SANITY_ZENOH_ENDPOINT="tcp/10.0.0.200:7447"
# CONFIG_SANITY_CTBR is not set
CONFIG_SANITY_MSP_UNIFIED=y
# CONFIG_SANITY_DIRECT_BENCH is not set
CONFIG_SANITY_UART_TX=4
CONFIG_SANITY_UART_RX=3
# CONFIG_SANITY_SBUS_INVERT is not set
CONFIG_SANITY_MSP_BAUD=115200
CONFIG_SANITY_BENCH_LIMIT_S=60
CONFIG_SANITY_USB_PASSTHROUGH=y
# CONFIG_SANITY_PASSTHROUGH_DEFAULT_ON is not set
CONFIG_SANITY_PASSTHROUGH_BAUD=115200
CONFIG_SANITY_PASSTHROUGH_BUTTON_GPIO=0
CONFIG_SANITY_PASSTHROUGH_LED_GPIO=21
CONFIG_SANITY_PASSTHROUGH_WINDOW_MS=4000
# CONFIG_SANITY_HX711 is not set
