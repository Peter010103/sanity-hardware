+/* Explicit Sanity15 timing experiment; default firmware keeps its native ODR.
+ * The ICM42688P driver programs gyro AND accelerometer physical ODR to 2 kHz.
+ * Accelerometer software polling stays at 1 kHz. Select pid_process_denom=1
+ * separately to obtain a 500 us PID/INDI/filter interval; saved configuration
+ * is never silently changed by this build profile.
+ */
+#pragma once
+
+#ifdef SANITY_GYRO_2KHZ
+#if !defined(USE_SANITY_INDI) || !defined(USE_SANITY_SENSOR_STREAM)
+#error "SANITY_GYRO_2KHZ requires both Sanity INDI and sensor streaming"
+#endif
+#if !defined(STM32F405) || !defined(USE_GYRO_SPI_ICM42688P)
+#error "SANITY_GYRO_2KHZ is restricted to the F405 ICM42688P experiment"
+#endif
+#define SANITY_GYRO_PROFILE_SAMPLE_HZ 2000
+#define SANITY_GYRO_PROFILE_DIVIDER_DROPS 3
+#define SANITY_GYRO_PROFILE_ACC_POLL_HZ 1000
+#define SANITY_GYRO_PROFILE_PID_DENOM 1
+#define SANITY_GYRO_PROFILE_PID_PERIOD_US 500
+#define SANITY_SENSOR_SAMPLE_UNCERTAINTY_US 500U
+#else
+#define SANITY_SENSOR_SAMPLE_UNCERTAINTY_US 125U
+#endif
