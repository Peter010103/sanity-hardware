+/* Sanity rotational INDI integration. GPL-3.0-or-later. */
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+#include "common/time.h"
+#include "sanity_indi/supervisor.h"
+#include "sanity_indi/trace.h"
+#define SANITY_INDI_MSP_TIMING 0x7f14
+#define SANITY_INDI_TIMING_SIZE 80
+#define SANITY_INDI_MSP_STATUS 0x7f11
+#define SANITY_INDI_PACKET_SIZE 80
+
+typedef struct {
+    bool active;
+    uint8_t fault;
+    uint8_t rpmMask, saturatedMask;
+    uint16_t lastRuntimeUs, maxRuntimeUs;
+    int16_t solverExit, iterations;
+    uint32_t steps;
+    float requestedThrustN;
+    float weight, trackingError, collectiveN;
+    uint8_t mode, reason, lastFault, requestAux;
+    bool enabled, requested, eligible, armed, shadowValid, supported, guardTriggered;
+    uint16_t transitions, fallbacks, cycleUs, maxCycleUs;
+    uint32_t readyUs, sequence;
+    float rate[3];
+} sanityIndiStatus_t;
+
+bool sanityIndiActive(void);
+void sanityIndiApply(timeUs_t now, float minimum, float maximum, float collectiveOutput,
+                     float outputMinimum, float outputRange, float pidMixScale, bool motorStop);
+void sanityIndiCycleStart(void);
+void sanityIndiCycleEnd(void);
+void sanityIndiEncode(uint8_t packet[SANITY_INDI_PACKET_SIZE]);
+void sanityIndiUpdateArmingStatus(void);
+const sanityIndiStatus_t *sanityIndiStatus(void);
+/* pid cycle excludes separate gyro sample/filter tasks, includes Blackbox. */
+void sanityIndiRecordTaskTime(bool filtering, uint32_t elapsedUs, uint32_t budgetUs);
+void sanityIndiEncodeTiming(uint8_t packet[SANITY_INDI_TIMING_SIZE]);
+bool sanityIndiTraceEnabled(void);
+void sanityIndiTraceSetRecording(bool enabled);
+void sanityIndiTraceSnapshot(int32_t fields[SI_TRACE_COUNT]);
+void sanityIndiRecordLogDrop(void);
diff --git a/src/main/flight/sanity_indi/core.c b/src/main/flight/sanity_indi/core.c
new file mode 100644
index 0000000..4121f2c
--- /dev/null
+++ b/src/main/flight/sanity_indi/core.c
@@ -0,0 +1,189 @@
+/* GPL-3.0-or-later. See core.h and lib/main/ActiveSetCtlAlloc/SANITY_PROVENANCE.json.
+ * Rotational incremental law adapted from INDIflight getMotorCommands:
+ * delta = allocate(alpha_cmd - alpha_filtered, F_cmd - F_filtered).
+ * Force and angular-acceleration feedback use identical Butterworth filters.
+ * The optional G2 rotor-acceleration term is deliberately zero in this port.
+ */
+#include "platform.h"
+#include <math.h>
+#include <string.h>
+#include "core.h"
+#include "model.h"
+#include "setupWLS.h"
+#include "solveActiveSet.h"
+
+static float clamp(float x, float low, float high)
+{
+    return fminf(high, fmaxf(low, x));
+}
+
+static void filterInit(siFilter_t *f, float hz, float dt)
+{
+    const float k = tanf(3.14159265358979323846f * hz * dt);
+    const float norm = 1.0f / (1.0f + 1.4142135623730951f * k + k * k);
+    memset(f, 0, sizeof(*f));
+    f->b0 = k * k * norm;
+    f->b1 = 2.0f * f->b0;
+    f->b2 = f->b0;
+    f->a1 = 2.0f * (k * k - 1.0f) * norm;
+    f->a2 = (1.0f - 1.4142135623730951f * k + k * k) * norm;
+}
+
+static float filterApply(siFilter_t *f, float x)
+{
+    const float y = f->b0 * x + f->b1 * f->x1 + f->b2 * f->x2 - f->a1 * f->y1 - f->a2 * f->y2;
+    f->x2 = f->x1; f->x1 = x; f->y2 = f->y1; f->y1 = y;
+    return y;
+}
+
+static void filterSeed(siFilter_t *f, float x)
+{
+    f->x1 = x; f->x2 = x; f->y1 = x; f->y2 = x;
+}
+
+bool siInit(siState_t *s, const siConfig_t *c)
+{
+    if (!s || !c || !isfinite(c->dt) || c->dt < 0.0001f || c->dt > 0.002f ||
+        !isfinite(c->cutoffHz) || c->cutoffHz < 1.0f || c->cutoffHz * c->dt > 0.1f ||
+        !c->maxIterations || c->maxIterations > 32) {
+        return false;
+    }
+    for (unsigned a = 0; a < 3; ++a) {
+        if (!isfinite(c->rateGain[a]) || c->rateGain[a] <= 0.0f || c->rateGain[a] > 100.0f) return false;
+    }
+    for (unsigned m = 0; m < 4; ++m) {
+        if (!isfinite(c->motorTau[m]) || c->motorTau[m] < 0.005f || c->motorTau[m] > 0.2f ||
+            !isfinite(c->axisWeight[m]) || c->axisWeight[m] <= 0.0f) return false;
+        for (unsigned a = 0; a < 4; ++a) if (!isfinite(c->effectiveness[a][m])) return false;
+    }
+    memset(s, 0, sizeof(*s));
+    s->config = *c;
+    for (unsigned a = 0; a < 3; ++a) filterInit(&s->alphaFilter[a], c->cutoffHz, c->dt);
+    for (unsigned m = 0; m < 4; ++m) filterInit(&s->forceFilter[m], c->cutoffHz, c->dt);
+    float B[16];
+    for (unsigned m = 0; m < 4; ++m) {
+        s->allocationWu[m] = 1.0f;
+        for (unsigned a = 0; a < 4; ++a) B[4*m+a] = c->effectiveness[a][m];
+    }
+    // INDIflight scales its stored condition bound by 1e4 at initialization.
+    // Geometry and weights are fixed for the arm session, so factor setup once.
+    setupWLS_A(B, c->axisWeight, s->allocationWu, 4, 4, 0.0001f, 327680000.0f,
+        s->allocationA, &s->allocationGamma);
+    if (!isfinite(s->allocationGamma)) return false;
+    return true;
+}
+
+void siResetRuntime(siState_t *s)
+{
+    s->initialized = false;
+    memset(s->previousRate, 0, sizeof(s->previousRate));
+    memset(s->modelForce, 0, sizeof(s->modelForce));
+    memset(s->filteredForce, 0, sizeof(s->filteredForce));
+    memset(s->filteredAlpha, 0, sizeof(s->filteredAlpha));
+    memset(s->delta, 0, sizeof(s->delta));
+    memset(s->workingSet, 0, sizeof(s->workingSet));
+    for (unsigned a = 0; a < 3; ++a) filterSeed(&s->alphaFilter[a], 0.0f);
+    for (unsigned m = 0; m < 4; ++m) filterSeed(&s->forceFilter[m], 0.0f);
+}
+
+bool siObserve(siState_t *s, const siInput_t *in)
+{
+    if (!s || !in || !isfinite(in->collectiveN) || in->collectiveN < 0.0f) return false;
+    for (unsigned a = 0; a < 3; ++a) if (!isfinite(in->rate[a]) || !isfinite(in->filteredRate[a]) || !isfinite(in->setpoint[a])) return false;
+    for (unsigned m = 0; m < 4; ++m) {
+        if (!isfinite(in->forceMin[m]) || !isfinite(in->forceMax[m]) ||
+            !isfinite(in->forceCommandedPrevious[m]) || in->forceMin[m] < 0.0f ||
+            in->forceMin[m] >= in->forceMax[m]) return false;
+    }
+    if (!s->initialized) {
+        for (unsigned a = 0; a < 3; ++a) s->previousRate[a] = in->rate[a];
+        for (unsigned m = 0; m < 4; ++m) {
+            s->modelForce[m] = in->forceCommandedPrevious[m];
+            filterSeed(&s->forceFilter[m], s->modelForce[m]);
+        }
+        s->initialized = true;
+    }
+    for (unsigned a = 0; a < 3; ++a) {
+        const float alpha = (in->rate[a] - s->previousRate[a]) / s->config.dt;
+        s->previousRate[a] = in->rate[a];
+        s->filteredAlpha[a] = filterApply(&s->alphaFilter[a], alpha);
+    }
+    for (unsigned m = 0; m < 4; ++m) {
+        const float gain = s->config.dt / (s->config.dt + s->config.motorTau[m]);
+        s->modelForce[m] += gain * (in->forceCommandedPrevious[m] - s->modelForce[m]);
+        s->filteredForce[m] = filterApply(&s->forceFilter[m], s->modelForce[m]);
+        if (!isfinite(s->filteredForce[m])) return false;
+    }
+    return true;
+}
+
+bool siAllocate(siState_t *s, const siInput_t *in)
+{
+    if (!s || !s->initialized || !in || !isfinite(in->collectiveN)) return false;
+    float objective[4] = {in->collectiveN / SI_MASS_KG, 0.0f, 0.0f, 0.0f};
+    for (unsigned a = 0; a < 3; ++a)
+        objective[a+1] = s->config.rateGain[a]*(in->setpoint[a]-in->filteredRate[a])-s->filteredAlpha[a];
+    float lo[4], hi[4], preferred[4];
+    for (unsigned m = 0; m < 4; ++m) {
+        objective[0] -= s->filteredForce[m] / SI_MASS_KG;
+        lo[m] = in->forceMin[m] - s->filteredForce[m];
+        hi[m] = in->forceMax[m] - s->filteredForce[m];
+        preferred[m] = -s->filteredForce[m];
+        /* Warm-start must remain feasible as voltage/limits change. */
+        s->delta[m] = clamp(s->delta[m], lo[m], hi[m]);
+        s->workingSet[m] = 0;
+    }
+    float rhs[8];
+    setupWLS_b(objective, preferred, s->config.axisWeight, s->allocationWu, 4, 4, s->allocationGamma, rhs);
+    int freeCount;
+    s->solverExit = solveActiveSet_qr(s->allocationA, rhs, lo, hi, s->delta, s->workingSet,
+        (int)s->config.maxIterations, 4, 4, &s->iterations, &freeCount, NULL);
+    if (s->solverExit >= AS_NAN_FOUND_Q) return false;
+    s->saturatedMask = 0;
+    for (unsigned m = 0; m < 4; ++m) {
+        if (!isfinite(s->delta[m])) return false;
+        s->force[m] = clamp(s->filteredForce[m] + s->delta[m], in->forceMin[m], in->forceMax[m]);
+        if (s->force[m] < in->forceMin[m] + 0.0001f || s->force[m] > in->forceMax[m] - 0.0001f) s->saturatedMask |= 1U << m;
+    }
+    return true;
+}
+
+bool siStep(siState_t *s, const siInput_t *in)
+{
+    return siObserve(s,in) && siAllocate(s,in);
+}
+
+float siMotorForce(float count, float voltage)
+{
+    if (!isfinite(count) || !isfinite(voltage)) return NAN;
+    /* As in INDIflight, this is the monotonic command linearization, not
+     * measured rotor force. Live RPM is deliberately not substituted into the
+     * incremental actuator baseline. Zero denotes the configured idle endpoint. */
+    const float d = clamp((count - 1100.0f) / 900.0f, 0.0f, 1.0f);
+    return SI_MOTOR_REFERENCE_FORCE_N * ((1.0f-SI_MOTOR_KAPPA)*d + SI_MOTOR_KAPPA*d*d);
+}
+
+bool siMotorInverse(float force, float voltage, float low, float high, float *count)
+{
+    if (!count || !isfinite(force) || !isfinite(voltage) || !isfinite(low) || !isfinite(high) ||
+        low < 1100.0f || high > 2000.0f || low >= high) return false;
+    /* Stable inverse of y = (1-kappa)*d + kappa*d*d. Preserve floating
+     * resolution for external-reset tracking: repeated coarse bisection or
+     * PWM rounding can erase each control cycle's small PID correction. */
+    const float y = clamp(force / SI_MOTOR_REFERENCE_FORCE_N, 0.0f, 1.0f);
+    const float linear = 1.0f - SI_MOTOR_KAPPA;
+    const float d = 2.0f * y / (linear + sqrtf(linear * linear + 4.0f * SI_MOTOR_KAPPA * y));
+    *count = clamp(1100.0f + 900.0f * d, low, high);
+    return isfinite(*count);
+}
+
+float siRequestedCollective(float rc, uint16_t mv)
+{
+    if (!isfinite(rc) || rc < SI_RC_MIN) return 0.0f;
+    if (!mv) mv = SI_VOLTAGE_FALLBACK_MV;
+    const float v = clamp((float)mv, SI_VOLTAGE_MIN_MV, SI_VOLTAGE_MAX_MV) * 0.001f;
+    const float q = (clamp(rc, SI_RC_MIN, SI_RC_MAX) - 1500.0f) / 400.0f, z = (v - 7.4f) / 0.8f;
+    const float speed = siRcSpeed[0] + siRcSpeed[1] * q + siRcSpeed[2] * z +
+        siRcSpeed[3] * q * q + siRcSpeed[4] * q * z + siRcSpeed[5] * z * z;
+    return 4.0f * SI_ESP_KT * speed * speed;
+}
diff --git a/src/main/flight/sanity_indi/core.h b/src/main/flight/sanity_indi/core.h
new file mode 100644
index 0000000..232e833
--- /dev/null
+++ b/src/main/flight/sanity_indi/core.h
@@ -0,0 +1,48 @@
+/* Sanity rotational INDI port. GPL-3.0-or-later.
+ * Incremental law and bounded WLS follow INDIflight 72c0b7614, Till Blaha,
+ * TU Delft. This rate-only adapter uses Betaflight's existing axis convention.
+ */
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+
+#define SI_MOTORS 4
+#define SI_AXES 3
+
+typedef struct {
+    float b0, b1, b2, a1, a2, x1, x2, y1, y2;
+} siFilter_t;
+
+typedef struct {
+    float dt, cutoffHz, rateGain[3], motorTau[4];
+    float effectiveness[4][4]; /* [collective acceleration, body alpha][motor force N] */
+    float axisWeight[4];
+    unsigned maxIterations;
+} siConfig_t;
+
+typedef struct {
+    float rate[3], filteredRate[3], setpoint[3]; /* rad/s, Betaflight rate/gyro convention */
+    float forceCommandedPrevious[4]; /* nominal command-force coordinate, N at reference condition */
+    float forceMin[4], forceMax[4], collectiveN;
+} siInput_t;
+
+typedef struct {
+    siConfig_t config;
+    siFilter_t alphaFilter[3], forceFilter[4];
+    float previousRate[3], modelForce[4], filteredForce[4], filteredAlpha[3];
+    float force[4], delta[4];
+    float allocationA[32], allocationWu[4], allocationGamma;
+    int8_t workingSet[4];
+    bool initialized;
+    int solverExit, iterations;
+    uint8_t saturatedMask;
+} siState_t;
+
+bool siInit(siState_t *state, const siConfig_t *config);
+void siResetRuntime(siState_t *state);
+bool siStep(siState_t *state, const siInput_t *input);
+bool siObserve(siState_t *state, const siInput_t *input);
+bool siAllocate(siState_t *state, const siInput_t *input);
+float siMotorForce(float externalMotorCount, float voltage); /* voltage unused: nominal linearization */
+bool siMotorInverse(float force, float voltage, float lowCount, float highCount, float *count);
+float siRequestedCollective(float rcThrottle, uint16_t voltageMv);
diff --git a/src/main/flight/sanity_indi/model.h b/src/main/flight/sanity_indi/model.h
new file mode 100644
index 0000000..9a8eaba
--- /dev/null
+++ b/src/main/flight/sanity_indi/model.h
@@ -0,0 +1,23 @@
+/* Generated by generate_model.py from existing measurements; do not hand edit.
+ * Initial model only. Physical rotor signs/poles, FC timing and flight response
+ * still require commissioning. G2 rotor-acceleration torque is omitted.
+ */
+#pragma once
+#define SI_MASS_KG 0.06947f
+#define SI_KT 3.275921725e-08f
+#define SI_KQ 1.588898828e-10f
+#define SI_ARM_X_M 0.0284610479f
+#define SI_ARM_Y_M 0.0284610479f
+#define SI_IXX 3.32e-05f
+#define SI_IYY 4.28e-05f
+#define SI_IZZ 5.43e-05f
+#define SI_ESP_KT 3.067640401e-08f
+#define SI_MOTOR_REFERENCE_FORCE_N 1.119439525f
+#define SI_MOTOR_KAPPA 0.3897426879f
+#define SI_RC_MIN 1100
+#define SI_RC_MAX 1900
+#define SI_VOLTAGE_MIN_MV 6618
+#define SI_VOLTAGE_MAX_MV 8172
+#define SI_VOLTAGE_FALLBACK_MV 8000
+#define SI_CALIBRATION_ID UINT32_C(0xf04fc735)
+static const float siRcSpeed[6] = {3358.128698f, 2260.704128f, 166.4871703f, -591.6992841f, -154.0906962f, -181.6084612f};
diff --git a/src/main/flight/sanity_indi/paper_adapter.c b/src/main/flight/sanity_indi/paper_adapter.c
new file mode 100644
index 0000000..06aa1c8
--- /dev/null
+++ b/src/main/flight/sanity_indi/paper_adapter.c
@@ -0,0 +1,778 @@
+/* Selectable measured-speed adapter; reference command-force branch untouched.
+ * MSP receive and PID are cooperative scheduler tasks. Raw decode uses bounded
+ * seqlock publication; no force observer state is reused. BF aligned gyro is
+ * FLU (installed estimator convention); FRD=diag(1,-1,-1)*FLU, det=+1.
+ */
+#include "platform.h"
+#ifdef USE_SANITY_INDI
+#include "common/maths.h"
+#include "config/config.h"
+#include "core.h"
+#include "drivers/dshot.h"
+#include "drivers/dshot_command.h"
+#include "drivers/motor.h"
+#include "drivers/time.h"
+#include "fc/core.h"
+#include "fc/rc.h"
+#include "fc/runtime_config.h"
+#include "flight/imu.h"
+#include "flight/mixer.h"
+#include "flight/mixer_init.h"
+#include "flight/pid.h"
+#include "model.h"
+#include "paper_adapter.h"
+#include "paper_core.h"
+#include "paper_rpm.h"
+#include "pg/motor.h"
+#include "pg/sanity_indi.h"
+#include "pg/sanity_paper.h"
+#include "pg/sanity_rate_ff.h"
+#include "rate_feedforward.h"
+#include "rx/rx.h"
+#include "sensors/battery.h"
+#include "sensors/gyro.h"
+#include <math.h>
+#include <string.h>
+static spState_t paper;
+static spNative_t native;
+static spRpmHistory_t rpm;
+static spRpmSelection_t selection;
+static shState_t policy;
+static sanityPaperConfig_t saved;
+static sanityRateFfConfig_t savedRateFf;
+static srFfState_t rateFf;
+static sanityIndiConfig_t supervisorConfig;
+static uint32_t configHash;
+static uint32_t period, previous, stableAt, slewStarted, slewDuration, guardAt,
+    badTakeoffAt;
+static float applied[4];
+static bool haveApplied, configured, configValid, armedLast, observationsValid,
+    slewActive;
+/* Engineering timing envelope, not a measured hardware qualification. One
+ * anomalous tick per 100ms; both dt and previous-runtime flags share one event.
+ * A second anomalous catchup tick is deliberately rejected. */
+#define SP_TIMING_QUIET_US 100000U
+#define SP_TIMING_SHORT 1U
+#define SP_TIMING_LONG 2U
+#define SP_TIMING_RUNTIME 4U
+#define SP_TIMING_HARD 8U
+#define SP_TIMING_REPEAT 16U
+#define SP_TIMING_GRACE 32U
+#define SP_TIMING_UNREADY 64U
+static struct {
+  uint32_t events, graces, rejects, reseeds, lastUs;
+  bool haveLast;
+  uint32_t first[6], rejected[6]; /* seq, now, dt, prevPID, flags, adapterUs */
+} timing;
+static uint8_t backend;
+static bool solveCurrent, solveValid;
+static uint16_t currentReason = 1;
+static uint32_t voltageStamp;
+static float deliveredVoltage;
+static bool haveVoltage;
+static int32_t trace[SP_TRACE_COUNT];
+static float clip(float x, float l, float h) { return fminf(h, fmaxf(l, x)); }
+static float toCount(float x) {
+  return x < DSHOT_MIN_THROTTLE ? 1000
+                                : scaleRangef(x, DSHOT_MIN_THROTTLE,
+                                              DSHOT_MAX_THROTTLE, 1001, 2000);
+}
+static float fromCount(float x) {
+  return x <= 1000 ? DSHOT_CMD_MOTOR_STOP
+                   : scaleRangef(clip(x, 1001, 2000), 1001, 2000,
+                                 DSHOT_MIN_THROTTLE, DSHOT_MAX_THROTTLE);
+}
+void sanityPaperHousekeeping(uint32_t now) {
+  spNativePoll(&native, now);
+  spRpmPoll(&rpm, now, 1000000U);
+}
+uint8_t sanityPaperBackend(bool armed) {
+  if (!armed && backend != sanityPaperConfig()->backend) {
+    backend = sanityPaperConfig()->backend;
+    native.accepted.flags = 0;
+    native.accepted.claimed = false;
+    native.expired = true;
+    native.accepted.expiryUs = micros();
+    native.consumedSession = native.consumedSequence = native.consumedUs = 0;
+  }
+  return backend;
+}
+bool sanityPaperTraceSelected(void) { return backend == 1; }
+bool sanityPaperConfigured(void) { return configured && configValid; }
+bool sanityPaperInitialized(void) { return paper.initialized; }
+void sanityPaperRecordVoltage(uint32_t stamp, float voltage) {
+  voltageStamp = stamp;
+  deliveredVoltage = voltage;
+  haveVoltage = true;
+}
+void sanityPaperRecordErpm(unsigned m, uint32_t stamp, uint32_t raw) {
+  spRpmRecord(&rpm, m, stamp, raw);
+}
+bool sanityPaperReceive(const uint8_t *p, unsigned n, uint32_t now) {
+  if (n == SP_NATIVE_SIZE && (p[7] & 1) &&
+      (backend != 1 || sanityPaperConfig()->inputSource != 0)) {
+    native.rejected++;
+    native.reason = 4;
+    return false;
+  }
+  return spNativeReceive(&native, p, n, now, ARMING_FLAG(ARMED));
+}
+static bool authority(void) {
+  return rxIsReceivingSignal() && !(flightModeFlags & ~FAILSAFE_MODE);
+}
+bool sanityPaperFallbackRate(unsigned a, float *out) {
+  if (a >= 3 || backend != 1 || saved.inputSource != 0 || !authority() ||
+      !native.accepted.claimed)
+    return false;
+  /* During controlled return retain the same bounded companion identity. */
+  if (!spNativeValid(&native, micros()) && !(policy.weight > 0))
+    return false;
+  *out = native.accepted.rate[a] * (a ? -1.0f : 1.0f) * (180.0f / M_PIf);
+  return true;
+}
+static bool configure(bool armed) {
+  sanityPaperConfig_t c = *sanityPaperConfig();
+  sanityRateFfConfig_t ff = *sanityRateFfConfig();
+  sanityIndiConfig_t sup = *sanityIndiConfig();
+  sup.traceEnabled = 0;
+  if (configured && period == targetPidLooptime &&
+      !memcmp(&c, &saved, sizeof(c)) &&
+      !memcmp(&ff, &savedRateFf, sizeof(ff)) &&
+      !memcmp(&sup, &supervisorConfig, sizeof(sup)) && (configValid || armed))
+    return configValid;
+  if (configured && armed) {
+    configValid = false;
+    return false;
+  }
+  if (configured && saved.inputSource != c.inputSource) {
+    native.accepted.flags = 0;
+    native.accepted.claimed = false;
+    native.expired = true;
+    native.accepted.expiryUs = micros();
+    native.consumedSession = native.consumedSequence = native.consumedUs = 0;
+  }
+  saved = c;
+  savedRateFf = ff;
+  supervisorConfig = sup;
+  // Hash the identical saved bytes only when a disarmed configuration is
+  // adopted. Trace flag-only changes are already excluded from this copy.
+  configHash = 2166136261U;
+  const uint8_t *configBytes = (const uint8_t *)&saved;
+  for (unsigned i = 0; i < sizeof(saved); i++)
+    configHash = (configHash ^ configBytes[i]) * 16777619U;
+  const uint8_t *supervisorBytes = (const uint8_t *)&supervisorConfig;
+  for (unsigned i = 0; i < sizeof(supervisorConfig); i++)
+    configHash = (configHash ^ supervisorBytes[i]) * 16777619U;
+  const uint8_t *ffBytes = (const uint8_t *)&savedRateFf;
+  for (unsigned i = 0; i < sizeof(savedRateFf); i++)
+    configHash = (configHash ^ ffBytes[i]) * 16777619U;
+  period = targetPidLooptime;
+  configured = true;
+  configValid = false;
+  stableAt = 0;
+  srFfConfig_t ffConfig = {.dt = period * 1e-6f, .cutoffHz = ff.cutoffHz};
+  for (unsigned a = 0; a < 3; a++) {
+    ffConfig.gain[a] = ff.gainMilli[a] * .001f;
+    ffConfig.limit[a] = ff.alphaLimit[a];
+  }
+  if (!srFfInit(&rateFf, &ffConfig))
+    return false;
+  if ((period != 500 && period != 1000) || c.backend != 1 ||
+      c.inputSource > 1 || !c.servoEnabled || c.cutoffHz < 1 ||
+      c.cutoffHz > 100 || c.rpmMaxAgeUs < 100 || c.rpmMaxAgeUs > 20000 ||
+      c.rpmMaxSkewUs > 20000 || c.voltageMaxAgeMs < 10 ||
+      c.voltageMaxAgeMs > 1000 || c.omegaMin >= c.omegaMax ||
+      c.omegaMax > 5883 || c.omegaMax < 100 || c.maxIterations < 1 ||
+      c.maxIterations > 20 || c.warmupMs > 1000 || !c.countSlew)
+    return false;
+  if (sup.transitionMs < 50 || sup.transitionMs > 1000 || sup.requestAux < 1 ||
+      sup.requestAux > 4 || sup.entryDwellMs < 100 || sup.entryDwellMs > 3000 ||
+      sup.entryDeltaPercent < 1 || sup.entryDeltaPercent > 20 ||
+      !sup.outputStepPermille || sup.outputStepPermille > 20 ||
+      sup.entryRateDps < 5 || sup.entryRateDps > 100 || sup.entryTiltDeg < 2 ||
+      sup.entryTiltDeg > 30 || sup.guardTimeMs < 50 || sup.guardTimeMs > 500 ||
+      sup.guardWindowMs < 1000 || sup.guardWindowMs > 30000)
+    return false;
+  spConfig_t cfg = {0};
+  cfg.dt = period * 1e-6f;
+  cfg.cutoffHz = c.cutoffHz;
+  cfg.inertia[0] = SI_IXX;
+  cfg.inertia[1] = SI_IYY;
+  cfg.inertia[2] = SI_IZZ;
+  cfg.kp = c.kpMilli * .001f;
+  cfg.ki = c.kiMilli * .001f;
+  cfg.kaw = c.kaw;
+  cfg.integralLimit = c.integralLimit;
+  cfg.countSlewPerSec = c.countSlew;
+  cfg.maxIterations = c.maxIterations;
+  cfg.warmupTicks = (uint32_t)c.warmupMs * 1000 / period;
+  const float x[4] = {-SI_ARM_X_M, SI_ARM_X_M, -SI_ARM_X_M, SI_ARM_X_M};
+  const float y[4] = {SI_ARM_Y_M, SI_ARM_Y_M, -SI_ARM_Y_M, -SI_ARM_Y_M};
+  const float yaw[4] = {-1, 1, 1, -1};
+  const float bfYawSign = mixerConfig()->yaw_motors_reversed ? 1 : -1;
+  for (unsigned m = 0; m < 4; m++) {
+    cfg.g1[0][m] = SI_KT;
+    cfg.g1[1][m] = -y[m] * SI_KT;
+    cfg.g1[2][m] = x[m] * SI_KT;
+    cfg.g1[3][m] = -bfYawSign * yaw[m] * SI_KQ;
+    cfg.g2[3][m] = -bfYawSign * yaw[m] * (float)c.rotorInertiaNano[m] * 1e-9f;
+    cfg.omegaMin[m] = c.omegaMin;
+    cfg.omegaMax[m] = c.omegaMax;
+  }
+  cfg.rowScale[0] = 1;
+  cfg.rowScale[1] = cfg.rowScale[2] = .02f;
+  cfg.rowScale[3] = .002f;
+  cfg.priority[0] = 4;
+  cfg.priority[1] = cfg.priority[2] = 8;
+  cfg.priority[3] = 1;
+  configValid = spInit(&paper, &cfg);
+  return configValid;
+}
+static void trackPid(float outMin, float outRange, float mixScale) {
+  float target[3] = {0};
+  const float yawSign = mixerConfig()->yaw_motors_reversed ? 1 : -1;
+  for (unsigned m = 0; m < 4; m++) {
+    const float out = (motor[m] - outMin) / outRange * .25f * 1000;
+    target[0] += out * mixerRuntime.currentMixer[m].roll;
+    target[1] += out * mixerRuntime.currentMixer[m].pitch;
+    target[2] += out * mixerRuntime.currentMixer[m].yaw * yawSign;
+  }
+  for (unsigned a = 0; a < 3; a++) {
+    target[a] /= mixScale;
+  }
+  pidTrackSanityOutput(target);
+}
+static void numericStop(void) {
+  setArmingDisabled(ARMING_DISABLED_RUNAWAY_TAKEOFF);
+  disarm(DISARM_REASON_RUNAWAY_TAKEOFF);
+  stableAt = 0;
+  policy.weight = 0;
+  policy.mode = SH_PID;
+  policy.fault = policy.lastFault = policy.reason = SH_NUMERIC;
+  for (unsigned m = 0; m < 4; m++)
+    motor[m] = mixerRuntime.disarmMotorOutput;
+}
+static int32_t quant(float x, float scale) {
+  x *= scale;
+  if (!isfinite(x)) {
+    trace[5] |= 1 << 16;
+    return 0;
+  }
+  if (x > 1e9f) {
+    trace[5] |= 1 << 17;
+    x = 1e9f;
+  } else if (x < -1e9f) {
+    trace[5] |= 1 << 17;
+    x = -1e9f;
+  }
+  return lrintf(x);
+}
+void sanityPaperApply(timeUs_t now, float minimum, float maximum,
