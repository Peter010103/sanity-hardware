diff --git a/src/main/flight/sanity_sensor.c b/src/main/flight/sanity_sensor.c
new file mode 100644
index 0000000..c807958
--- /dev/null
+++ b/src/main/flight/sanity_sensor.c
@@ -0,0 +1,169 @@
+/* Experimental logging only: no controller dependencies, no serial IO in
+ * sampling hooks. */
+#include "platform.h"
+#ifdef USE_SANITY_SENSOR_STREAM
+#include "drivers/time.h"
+#include "fc/runtime_config.h"
+#include "flight/sanity_sensor.h"
+#include <string.h>
+#define QUEUE 8
+static se_sensor_packet packets[QUEUE];
+static unsigned head, count;
+static uint32_t dropped, sequence, lastEmit, lastGyro, lastAccel;
+static uint64_t epoch, extended;
+static uint32_t previousRaw;
+static bool haveTime;
+static float gs[3], as[3];
+static uint64_t gt, at;
+static unsigned gn, an;
+static uint32_t gu, au;
+static uint8_t gsource, asource;
+static bool gcal, acal;
+static float gyroLpf[4][3], accelLpf[4][3];
+static bool gyroLpfReady, accelLpfReady;
+static uint32_t gyroLpfStamp, accelLpfStamp;
+/* Four cascaded40HzPT1 sections before200Hz boxcar decimation. Lowfrequency
+ * groupdelay4/(2*pi*40)=15915us is encoded separately from acquisitiontime.
+ * Frequencydependent groupdelay remains an explicitly documented model limit.
+ */
+static void lowpass(float state[4][3], bool *ready, uint32_t *last,
+                    uint32_t stamp, const float in[3], float out[3]) {
+  if (!*ready || (uint32_t)(stamp - *last) > 15000) {
+    for (int s = 0; s < 4; s++)
+      for (int a = 0; a < 3; a++)
+        state[s][a] = in[a];
+    *ready = true;
+  }
+  float dt = (uint32_t)(stamp - *last) * 1e-6f;
+  *last = stamp;
+  float gain = dt / (0.0039788735773f + dt);
+  for (int a = 0; a < 3; a++) {
+    float x = in[a];
+    for (int s = 0; s < 4; s++) {
+      state[s][a] += gain * (x - state[s][a]);
+      x = state[s][a];
+    }
+    out[a] = x;
+  }
+}
+/* Called from cooperative scheduler contexts only, never DMA/interrupt
+ * handlers. */
+static uint64_t clock64(void) {
+  uint32_t t = micros();
+  if (!haveTime) {
+    extended = t;
+    haveTime = true;
+  } else
+    extended += (uint32_t)(t - previousRaw);
+  previousRaw = t;
+  return extended;
+}
+static void clearWindow(void) {
+  memset(gs, 0, sizeof(gs));
+  memset(as, 0, sizeof(as));
+  gt = at = 0;
+  gn = an = 0;
+  gu = au = 0;
+  gcal = acal = true;
+}
+static void emit(uint32_t now) {
+  if (!epoch || !gn || !an || (uint32_t)(now - lastEmit) < 5000)
+    return;
+  lastEmit = now;
+  se_sensor_packet p = {0};
+  p.epoch = epoch;
+  p.sequence = ++sequence;
+  p.gyro_us = (uint32_t)(gt / gn);
+  p.accel_us = (uint32_t)(at / an);
+  p.gyro_uncertainty_us = gu;
+  p.accel_uncertainty_us = au;
+  p.flags = SE_FLAG_GYRO_VALID | SE_FLAG_ACC_VALID |
+            (gcal && acal ? SE_FLAG_CALIBRATED : 0) |
+            (!ARMING_FLAG(ARMED) ? SE_FLAG_DISARMED : 0);
+  p.gyro_delay_us = p.accel_delay_us = 15915;
+  p.gyro_source = gsource;
+  p.accel_source = asource;
+  for (int a = 0; a < 3; a++) {
+    p.gyro[a] = gs[a] / gn;
+    p.accel[a] = as[a] / an;
+  }
+  if (count == QUEUE) {
+    head = (head + 1) % QUEUE;
+    count--;
+    dropped++;
+  }
+  p.dropped = dropped;
+  packets[(head + count) % QUEUE] = p;
+  count++;
+  clearWindow();
+}
+void sanitySensorGyro(uint32_t stamp, const float dps[3], bool calibrated,
+                      bool fresh, uint8_t source, uint32_t uncertainty) {
+  clock64();
+  if ((uint32_t)((uint32_t)extended - lastEmit) > 15000) {
+    clearWindow();
+    lastEmit = (uint32_t)extended;
+  }
+  if (!fresh || (lastGyro && (int32_t)(stamp - lastGyro) <= 0))
+    return;
+  lastGyro = stamp;
+  float filtered[3];
+  lowpass(gyroLpf, &gyroLpfReady, &gyroLpfStamp, stamp, dps, filtered);
+  if (!gn)
+    gcal = true;
+  for (int a = 0; a < 3; a++)
+    gs[a] += filtered[a] * (0.017453292519943295f);
+  gt += extended - (uint32_t)((uint32_t)extended - stamp);
+  gn++;
+  gcal &= calibrated;
+  if (uncertainty > gu)
+    gu = uncertainty;
+  gsource = source;
+  emit((uint32_t)extended);
+}
+void sanitySensorAccel(uint32_t stamp, const float counts[3], float oneG,
+                       bool calibrated, bool fresh, uint8_t source,
+                       uint32_t uncertainty) {
+  clock64();
+  if ((uint32_t)((uint32_t)extended - lastEmit) > 15000) {
+    clearWindow();
+    lastEmit = (uint32_t)extended;
+  }
+  if (!fresh || oneG <= 0 || (lastAccel && (int32_t)(stamp - lastAccel) <= 0))
+    return;
+  lastAccel = stamp;
+  float filtered[3];
+  lowpass(accelLpf, &accelLpfReady, &accelLpfStamp, stamp, counts, filtered);
+  if (!an)
+    acal = true;
+  for (int a = 0; a < 3; a++)
+    as[a] += filtered[a] * (9.80665f / oneG);
+  at += extended - (uint32_t)((uint32_t)extended - stamp);
+  an++;
+  acal &= calibrated;
+  if (uncertainty > au)
+    au = uncertainty;
+  asource = source;
+  emit((uint32_t)extended);
+}
+bool sanitySensorPop(uint8_t out[SE_WIRE_SENSOR_SIZE]) {
+  if (!count)
+    return false;
+  se_sensor_encode(&packets[head], out);
+  head = (head + 1) % QUEUE;
+  count--;
+  return true;
+}
+void sanitySensorClock(const se_clock_packet *r, se_clock_packet *out) {
+  uint64_t now = clock64();
+  if (!epoch) {
+    epoch = r->nonce ? r->nonce : 1;
+    clearWindow();
+    lastEmit = (uint32_t)now;
+  }
+  *out = *r;
+  out->epoch = epoch;
+  out->t2 = now;
+  out->t3 = clock64();
+}
+#endif
