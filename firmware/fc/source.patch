diff --git a/Makefile b/Makefile
index 18fbdc8..d64dbce 100644
--- a/Makefile
+++ b/Makefile
@@ -420,6 +420,17 @@ $(TARGET_ELF): $(TARGET_OBJS) $(LD_SCRIPT) $(LD_SCRIPTS)
 
 # Compile
 
+ifneq ($(filter USE_SANITY_INDI,$(OPTIONS)),)
+# Finite-value checks in the controller/allocator must survive optimization.
+# Keep these objects outside LTO, so link-time -Ofast cannot remove the checks.
+$(TARGET_OBJ_DIR)/flight/sanity_indi.o $(TARGET_OBJ_DIR)/flight/sanity_indi/core.o $(addsuffix .o,$(addprefix $(TARGET_OBJ_DIR)/,$(basename $(AS_SRC)))): CC_SPEED_OPTIMISATION := -O2 -fno-fast-math -fno-finite-math-only -fno-lto -fstack-usage -frecord-gcc-switches
+$(TARGET_OBJ_DIR)/flight/sanity_force.o $(TARGET_OBJ_DIR)/flight/sanity_force/core.o: CC_SPEED_OPTIMISATION := -O2 -fno-fast-math -fno-finite-math-only -fno-lto -fstack-usage -frecord-gcc-switches
+$(TARGET_OBJ_DIR)/flight/sanity_indi/rate_feedforward.o $(TARGET_OBJ_DIR)/flight/sanity_indi/paper_adapter.o $(TARGET_OBJ_DIR)/flight/sanity_indi/paper_native.o $(TARGET_OBJ_DIR)/flight/sanity_indi/paper_rpm.o $(TARGET_OBJ_DIR)/flight/sanity_indi/supervisor.o: CC_SPEED_OPTIMISATION := -O2 -fno-fast-math -fno-finite-math-only -fno-lto -fstack-usage -frecord-gcc-switches
+# Keep the reduced paper polynomial evaluation consistent with numerical validation.
+$(TARGET_OBJ_DIR)/flight/sanity_indi/paper_core.o : CC_SPEED_OPTIMISATION := -O2 -fno-fast-math -fno-finite-math-only -fno-lto -fstack-usage -frecord-gcc-switches -ffp-contract=off
+LD_FLAGS += -Wl,--defsym=__sanity_indi_stack_size=4096
+endif
+
 ## compile_file takes two arguments: (1) optimisation description string and (2) optimisation compiler flag
 define compile_file
 	echo "%% ($(1)) $<" "$(STDOUT)" && \
