diff --git a/src/main/flight/sanity_indi/paper_core.c b/src/main/flight/sanity_indi/paper_core.c
new file mode 100644
index 0000000..9146c89
--- /dev/null
+++ b/src/main/flight/sanity_indi/paper_core.c
@@ -0,0 +1,396 @@
+/* S7--S10 measured-speed backend; bounded nonlinear allocation is an explicit
+ * engineering extension. No exact-runtime or hardware qualification is implied. */
+#include "paper_core.h"
+#include "paper_model.h"
+#ifdef SP_SPEED_MODEL_HEADER
+#include SP_SPEED_MODEL_HEADER
+#else
+#include "speed_model.h"
+#endif
+#include <math.h>
+#include <string.h>
+
+#define SP_MAX_OUTER 20u
+#define SP_MAX_ACTIVE 16u
+#define SP_EXACT_TOL 0.0001f
+#define SP_STEP_TOL 0.000002f
+static float spClamp(float x, float lo, float hi) { return fminf(hi, fmaxf(lo, x)); }
+static bool spFinite(const float *x, unsigned n) { for (unsigned i=0;i<n;i++) if (!isfinite(x[i])) return false; return true; }
+
+bool spInit(spState_t *s, const spConfig_t *c)
+{
+    if (!s || !c) return false;
+    memset(s,0,sizeof(*s));
+    if (!isfinite(c->dt) || (fabsf(c->dt-0.001f)>1e-8f && fabsf(c->dt-0.0005f)>1e-8f)
+        || !isfinite(c->cutoffHz) || c->cutoffHz<=0 || c->cutoffHz>=0.45f/c->dt
+        || !spFinite(c->inertia,3) || !spFinite(&c->g1[0][0],16) || !spFinite(&c->g2[0][0],16)
+        || !spFinite(c->omegaMin,4) || !spFinite(c->omegaMax,4) || !spFinite(c->rowScale,4) || !spFinite(c->priority,4)
+        || !c->maxIterations || c->maxIterations>SP_MAX_OUTER || c->warmupTicks>10000u
+        || !isfinite(c->kp) || !isfinite(c->ki) || !isfinite(c->kaw) || !isfinite(c->integralLimit) || !isfinite(c->countSlewPerSec)
+        || c->kp<0 || c->ki<0 || c->kaw<0 || c->integralLimit<0 || c->countSlewPerSec<0) return false;
+    for (unsigned i=0;i<4;i++) if (c->omegaMin[i]<0 || c->omegaMax[i]<=c->omegaMin[i] || c->omegaMax[i]>100000.0f || c->rowScale[i]<=0 || c->priority[i]<=0) return false;
+    for (unsigned i=0;i<3;i++) if (c->inertia[i]<=0) return false;
+    s->config=*c;
+    const float k=tanf(3.14159265358979323846f*c->cutoffHz*c->dt);
+    const float norm=1.0f/(1.0f+1.4142135623730951f*k+k*k);
+    s->b0=k*k*norm; s->b1=2*s->b0; s->b2=s->b0;
+    s->a1=2.0f*(k*k-1.0f)*norm; s->a2=(1.0f-1.4142135623730951f*k+k*k)*norm;
+    s->initialized=true; s->solverCode=SP_SOLVER_NONE;
+    return true;
+}
+void spReset(spState_t *s)
+{
+    if (!s) return;
+    const spConfig_t c=s->config;
+    if (s->initialized) (void)spInit(s,&c); else memset(s,0,sizeof(*s));
+}
+static float spFilter(spState_t *s, unsigned channel, float x)
+{
+    float y=s->b0*x+s->filterZ1[channel];
+    s->filterZ1[channel]=s->b1*x-s->a1*y+s->filterZ2[channel];
+    s->filterZ2[channel]=s->b2*x-s->a2*y;
+    return y;
+}
+static void spSeedFilter(spState_t *s, unsigned channel, float x)
+{
+    s->filterZ1[channel]=(1.0f-s->b0)*x;
+    s->filterZ2[channel]=(s->b2-s->a2)*x;
+}
+bool spObserve(spState_t *s, const float omega[4], const float body[3])
+{
+    if (!s || !s->initialized || !omega || !body) return false;
+    bool valid=spFinite(omega,4)&&spFinite(body,3);
+    for (unsigned i=0;i<4;i++) valid=valid&&omega[i]>=0&&omega[i]<=2*s->config.omegaMax[i];
+    if (!valid) { spReset(s); return false; }
+    const bool seed=!s->observed;
+    for (unsigned i=0;i<4;i++) {
+        if (seed) { spSeedFilter(s,i,omega[i]); s->omegaFiltered[i]=omega[i]; s->omegaPrevious[i]=omega[i]; s->omegaCommand[i]=omega[i]; }
+        else s->omegaFiltered[i]=spFilter(s,i,omega[i]);
+    }
+    for (unsigned i=0;i<3;i++) {
+        if (seed) { spSeedFilter(s,i+4,body[i]); s->bodyFiltered[i]=body[i]; s->alphaFiltered[i]=0; }
+        else { s->bodyFiltered[i]=spFilter(s,i+4,body[i]); s->alphaFiltered[i]=(s->bodyFiltered[i]-s->observedBodyPrevious[i])/s->config.dt; }
+        s->observedBodyPrevious[i]=s->bodyFiltered[i]; s->tauFiltered[i]=0; s->g2Torque[i]=0;
+        for (unsigned m=0;m<4;m++) {
+            const float accel=seed?0:(s->omegaFiltered[m]-s->observedOmegaPrevious[m])/s->config.dt;
+            s->g2Torque[i]+=s->config.g2[i+1][m]*accel;
+            s->tauFiltered[i]+=s->config.g1[i+1][m]*s->omegaFiltered[m]*s->omegaFiltered[m];
+        }
+        s->tauFiltered[i]+=s->g2Torque[i];
+    }
+    memcpy(s->observedOmegaPrevious,s->omegaFiltered,sizeof(s->omegaFiltered));
+    if (!spFinite(s->tauFiltered,3)||!spFinite(s->alphaFiltered,3)) {spReset(s);return false;}
+    s->observed=true; s->allocated=false; s->ticks++;
+    s->ready=s->ticks>=s->config.warmupTicks;
+    return true;
+}
+
+bool spReseedObservation(spState_t *s, const float omega[4], const float body[3])
+{
+    if (!s || !s->initialized || !s->observed || !s->ready) return false;
+    /* spObserve validates inputs and rebuilds BOTH H branches coherently. Its
+     * seed path overwrites all biquad and differentiation histories, sets
+     * alpha/g2 acceleration to zero, and rebuilds static measured torque. */
+    const unsigned ticks=s->ticks;
+    s->observed=false;
+    s->allocated=false;
+    s->servoPending=false;
+    if (!spObserve(s,omega,body)) return false;
+    s->ticks=ticks;
+    s->ready=true;
+    return true;
+}
+
+/* Fixed-size pivoted elimination. Numerical row/variable normalization occurs
+ * before this helper. Unregularized rank check is separate from LM damping. */
+static bool spLinear(float h[4][4], float rhs[4], const unsigned index[4], unsigned n, float out[4], bool damping)
+{
+    float a[4][5]={{0}}, matrixScale=0;
+    for (unsigned i=0;i<n;i++) { for (unsigned j=0;j<n;j++) a[i][j]=h[index[i]][index[j]]+(damping&&i==j?1e-7f:0); a[i][n]=rhs[index[i]]; }
+    for (unsigned i=0;i<n;i++) for(unsigned j=0;j<n;j++) matrixScale=fmaxf(matrixScale,fabsf(a[i][j]));
+    const float pivotTolerance=damping?1e-10f:fmaxf(1e-10f,1e-6f*matrixScale);
+    for (unsigned col=0;col<n;col++) {
+        unsigned p=col;
+        for (unsigned j=col+1;j<n;j++) if (fabsf(a[j][col])>fabsf(a[p][col])) p=j;
+        if (!isfinite(a[p][col])||fabsf(a[p][col])<pivotTolerance) return false;
+        if (p!=col) for(unsigned j=col;j<=n;j++){float tmp=a[p][j];a[p][j]=a[col][j];a[col][j]=tmp;}
+        for(unsigned row=col+1;row<n;row++){const float ratio=a[row][col]/a[col][col];for(unsigned j=col+1;j<=n;j++)a[row][j]-=ratio*a[col][j];}
+    }
+    for(unsigned k=n;k>0;k--){unsigned i=k-1;float v=a[i][n];for(unsigned j=i+1;j<n;j++)v-=a[i][j]*out[index[j]];out[index[i]]=v/a[i][i];}
+    return spFinite(out,4);
+}
+/* Box constrained Gauss--Newton subproblem. Add/remove a bound using the KKT
+ * multiplier, interpolate to first blocking bound; cap guarantees finite work. */
+static bool spBoxStep(float a[4][4], float residual[4], const float lo[4], const float hi[4], float d[4], bool *rank)
+{
+    float h[4][4]={{0}},g[4]={0}; int active[4]={0};
+    for(unsigned i=0;i<4;i++){d[i]=0;for(unsigned r=0;r<4;r++){g[i]+=a[r][i]*residual[r];for(unsigned j=0;j<4;j++)h[i][j]+=a[r][i]*a[r][j];}}
+    unsigned all[4]={0,1,2,3};float probe[4]={0};*rank=spLinear(h,g,all,4,probe,false);
+    for(unsigned iter=0;iter<SP_MAX_ACTIVE;iter++){
+        unsigned freeIndex[4],n=0;float rhs[4],candidate[4];memcpy(candidate,d,sizeof(candidate));
+        for(unsigned i=0;i<4;i++){rhs[i]=g[i];for(unsigned j=0;j<4;j++)if(active[j])rhs[i]-=h[i][j]*d[j];if(!active[i])freeIndex[n++]=i;}
+        if(n&&!spLinear(h,rhs,freeIndex,n,candidate,true))return false;
+        float fraction=1;int blocking=-1,side=0;
+        for(unsigned i=0;i<4;i++)if(!active[i]){
+            if(candidate[i]<lo[i]&&candidate[i]<d[i]){float f=(lo[i]-d[i])/(candidate[i]-d[i]);if(f<fraction){fraction=f;blocking=(int)i;side=-1;}}
+            if(candidate[i]>hi[i]&&candidate[i]>d[i]){float f=(hi[i]-d[i])/(candidate[i]-d[i]);if(f<fraction){fraction=f;blocking=(int)i;side=1;}}
+        }
+        for(unsigned i=0;i<4;i++)d[i]+=fraction*(candidate[i]-d[i]);
+        if(blocking>=0){d[blocking]=side<0?lo[blocking]:hi[blocking];active[blocking]=side;continue;}
+        float worst=1e-6f;int release=-1;
+        for(unsigned i=0;i<4;i++)if(active[i]){float gradient=-g[i];for(unsigned j=0;j<4;j++)gradient+=h[i][j]*d[j];float violation=active[i]<0?-gradient:gradient;if(violation>worst){worst=violation;release=(int)i;}}
+        if(release<0)return true;
+        active[release]=0;
+    }
+    return false;
+}
+static float spResidual(const spState_t *s,const float x[4],const float desired[4],float residual[4],float weighted[4])
+{
+    float cost=0;
+    for(unsigned r=0;r<4;r++){
+        float prediction=0;
+        for(unsigned m=0;m<4;m++){float omega=x[m]*s->config.omegaMax[m];prediction+=s->config.g1[r][m]*omega*omega+s->config.g2[r][m]*(omega-s->omegaPrevious[m])/s->config.dt;}
+        residual[r]=desired[r]-prediction;
+        weighted[r]=residual[r]/s->config.rowScale[r]*sqrtf(s->config.priority[r]);cost+=weighted[r]*weighted[r];
+    }
+    return cost;
+}
+/* Coordinate-normalized projected gradient on the PHYSICAL box. Artificial
+ * trust bounds and failed line searches cannot establish constrained optimality.
+ * This is a KKT numerical tolerance, separate from the physical residual test. */
+static bool spStationary(const spState_t *s,const float x[4],const float wr[4])
+{
+    for(unsigned m=0;m<4;m++){
+        float g=0,diagonal=0;
+        for(unsigned row=0;row<4;row++){
+            float omega=x[m]*s->config.omegaMax[m];
+            float a=(2*s->config.g1[row][m]*omega+s->config.g2[row][m]/s->config.dt)*s->config.omegaMax[m]/s->config.rowScale[row]*sqrtf(s->config.priority[row]);
+            g+=a*wr[row];diagonal+=a*a;
+        }
+        if(!isfinite(g)||!isfinite(diagonal))return false;
+        float projected=spClamp(x[m]+g/fmaxf(diagonal,1e-6f),s->config.omegaMin[m]/s->config.omegaMax[m],1.0f)-x[m];
+        if(fabsf(projected)>0.00002f)return false;
+    }
+    return true;
+}
+static bool spExact(const spState_t *s,const float r[4])
+{for(unsigned i=0;i<4;i++)if(fabsf(r[i])/s->config.rowScale[i]>SP_EXACT_TOL)return false;return true;}
+bool spAllocate(spState_t *s,float collective,const float alpha[3])
+{
+    if(!s)return false;
+    s->allocated=false;
+    if(!s->initialized||!s->observed||!s->ready||!alpha)return false;
+    s->iterations=0;s->saturatedMask=0;s->solverCode=SP_SOLVER_NUMERIC;
+    if(!isfinite(collective)||collective<0||!spFinite(alpha,3))return false;
+    float desired[4]={collective,0,0,0},x[4],r[4],wr[4];
+    for(unsigned i=0;i<3;i++){s->tauDesired[i]=s->tauFiltered[i]+s->config.inertia[i]*(alpha[i]-s->alphaFiltered[i]);desired[i+1]=s->tauDesired[i];}
+    if(!spFinite(desired,4))return false;
+    float totalKt=0,maxStart=0;for(unsigned m=0;m<4;m++){totalKt+=s->config.g1[0][m];maxStart=fmaxf(maxStart,s->omegaPrevious[m]);}
+    for(unsigned m=0;m<4;m++){
+        float start=s->omegaPrevious[m];
+        /* The zero-speed static Jacobian vanishes: an interior collective seed
+         * is used only there. This is numerical initialization, never history. */
+        if(maxStart<1.0f&&totalKt>0)start=sqrtf(collective/totalKt);
+        x[m]=spClamp(start,s->config.omegaMin[m],s->config.omegaMax[m])/s->config.omegaMax[m];
+    }
+    float cost=spResidual(s,x,desired,r,wr);bool stationary=false,rank=true;
+    if(!isfinite(cost))return false;
+    for(unsigned outer=0;outer<s->config.maxIterations;outer++){
+        if(spExact(s,r)){s->solverCode=SP_SOLVER_EXACT;break;}
+        float a[4][4],lo[4],hi[4],step[4];
+        for(unsigned m=0;m<4;m++){
+            float omega=x[m]*s->config.omegaMax[m];
+            lo[m]=fmaxf(s->config.omegaMin[m]/s->config.omegaMax[m]-x[m],-0.35f);hi[m]=fminf(1.0f-x[m],0.35f);
+            for(unsigned row=0;row<4;row++)a[row][m]=(2*s->config.g1[row][m]*omega+s->config.g2[row][m]/s->config.dt)*s->config.omegaMax[m]/s->config.rowScale[row]*sqrtf(s->config.priority[row]);
+        }
+        s->iterations=outer+1;
+        if(!spBoxStep(a,wr,lo,hi,step,&rank)){s->solverCode=rank?SP_SOLVER_ITERATION:SP_SOLVER_SINGULAR;break;}
+        float maxStep=0;for(unsigned m=0;m<4;m++)maxStep=fmaxf(maxStep,fabsf(step[m]));
+        if(maxStep<SP_STEP_TOL){stationary=true;break;}
+        bool accepted=false;
+        for(unsigned line=0;line<10;line++){
+            float trial[4],trialR[4],trialWr[4];float fraction=ldexpf(1.0f,-(int)line);
+            for(unsigned m=0;m<4;m++)trial[m]=spClamp(x[m]+fraction*step[m],s->config.omegaMin[m]/s->config.omegaMax[m],1.0f);
+            float next=spResidual(s,trial,desired,trialR,trialWr);
+            if(isfinite(next)&&next<cost){float improvement=cost-next;cost=next;memcpy(x,trial,sizeof(x));memcpy(r,trialR,sizeof(r));memcpy(wr,trialWr,sizeof(wr));accepted=true;if(improvement<1e-10f*fmaxf(1.0f,cost))stationary=true;break;}
+        }
+        if(!accepted){stationary=true;break;}
+        if(stationary)break;
+    }
+    memcpy(s->residual,r,sizeof(r));
+    if(spExact(s,r))s->solverCode=SP_SOLVER_EXACT;
+    else if(!rank)s->solverCode=SP_SOLVER_SINGULAR;
+    else if(stationary&&spStationary(s,x,wr))s->solverCode=SP_SOLVER_BOUNDED;
+    else if(s->solverCode==SP_SOLVER_NUMERIC)s->solverCode=SP_SOLVER_ITERATION;
+    for(unsigned m=0;m<4;m++){
+        s->omegaCommand[m]=x[m]*s->config.omegaMax[m];
+        if(x[m]<=s->config.omegaMin[m]/s->config.omegaMax[m]+1e-5f||x[m]>=1-1e-5f)s->saturatedMask|=(uint8_t)(1u<<m);
+    }
+    s->allocated=(s->solverCode==SP_SOLVER_EXACT||s->solverCode==SP_SOLVER_BOUNDED)&&spFinite(s->omegaCommand,4);
+    return s->allocated;
+}
+void spCommit(spState_t *s)
+{if(s&&s->allocated){memcpy(s->omegaPrevious,s->omegaCommand,sizeof(s->omegaPrevious));s->allocated=false;}}
+
+/* Confidence is separate from actuator authority. A finite unsupported model
+ * never raises the requested speed/count to a calibration boundary. */
+uint32_t spFeedforwardModelFingerprint(void)
+{return SM_MODEL_FINGERPRINT;}
+static bool spModelUsable(smStatus_t status)
+{
+    return status == SM_TRUSTED_IN_SUPPORT ||
+        (SP_FF_ACCEPT_TRANSFER && status == SM_TRANSFER);
+}
+static uint8_t spModelReason(smStatus_t status)
+{
+    return status == SM_TRUSTED_IN_SUPPORT ? 0 :
+        status == SM_TRANSFER ? SP_FF_TRANSFER :
+        status == SM_UNSUPPORTED ? SP_FF_UNSUPPORTED : SP_FF_INVALID;
+}
+static uint32_t spIncrement(uint32_t value)
+{return value == UINT32_MAX ? value : value + 1u;}
+static bool spServoReject(spState_t *s, uint8_t reason)
+{
+    /* Failure diagnostics are current; all control histories remain untouched. */
+    s->servoFailure = reason;
+    s->voltageSupport = SP_FF_INVALID;
+    return false;
+}
+bool spFeedforward(float omega, float voltage, float low, float high,
+    float *count, uint8_t *support)
+{
+    if (!count || !support || !isfinite(low) || !isfinite(high) || low >= high)
+        return false;
+    float candidate = 0; uint16_t flags = 0;
+    const smStatus_t result = smInverse(omega, voltage, 0, &candidate, &flags);
+    *support = spModelReason(result);
+    if (!spModelUsable(result) || !isfinite(candidate) || candidate < low || candidate > high)
+        return false;
+    *count = candidate;
+    return true;
+}
+bool spServo(spState_t *s, const float measured[4], float voltage,
+    float low, float high, const float applied[4], bool seed)
+{
+    if (!s) return false;
+    s->servoPending = false;
+    if (!s->initialized || !s->ready || !measured || !applied)
+        return spServoReject(s, SP_SERVO_STATE);
+    if (!spFinite(measured, 4) || !spFinite(applied, 4) ||
+        !spFinite(s->omegaCommand, 4) || !isfinite(voltage) || voltage <= 0 ||
+        !isfinite(low) || !isfinite(high) || low >= high)
+        return spServoReject(s, SP_SERVO_INPUT);
+    /* Model and control locals make a late failure transactional. */
+    float ff[4], candidate[4] = {0}, error[4], proportional[4], integral[4], count[4];
+    uint16_t modelFlags[4] = {0}, recoveryTicks[4] = {0};
+    uint8_t reason[4] = {0}, validMask = 0, candidateMask = 0;
+    uint8_t degradedMask = 0, heldMask = 0, recoveringMask = 0, seededMask = 0, iSaturatedMask = 0;
+    uint32_t entries = s->ffDegradedEntries, recoveries = s->ffRecoveries;
+    const unsigned dwellTicks = (unsigned)ceilf(SP_FF_RECOVERY_DWELL_S / s->config.dt);
+    for (unsigned i = 0; i < 4; i++) {
+        const uint8_t bit = (uint8_t)(1u << i);
+        if (measured[i] < 0 || measured[i] > 2 * s->config.omegaMax[i] ||
+            s->omegaCommand[i] < 0 || s->omegaCommand[i] > 100000)
+            return spServoReject(s, SP_SERVO_INPUT);
+        const smStatus_t status = smInverse(s->omegaCommand[i], voltage, i,
+                                            &candidate[i], &modelFlags[i]);
+        if (status != SM_TRUSTED_IN_SUPPORT && status != SM_TRANSFER && status != SM_UNSUPPORTED)
+            return spServoReject(s, SP_SERVO_MODEL);
+        const bool modelCandidate = status == SM_TRUSTED_IN_SUPPORT || status == SM_TRANSFER;
+        if (modelCandidate && !isfinite(candidate[i]))
+            return spServoReject(s, SP_SERVO_MODEL);
+        if (modelCandidate) candidateMask |= bit;
+        else candidate[i] = 0; /* Mask distinguishes absent model result from zero. */
+        const bool usable = spModelUsable(status);
+        const bool haveHistory = (s->ffValidMask & bit) != 0;
+        const bool wasHeld = (s->ffHeldMask & bit) != 0;
+        bool held = !usable || wasHeld;
+        bool seeded = haveHistory && (s->ffSeededMask & bit);
+        reason[i] = spModelReason(status);
+        if (haveHistory && (!isfinite(s->feedforward[i]) || !isfinite(s->servoI[i])))
+            return spServoReject(s, SP_SERVO_NUMERIC);
+        if (!haveHistory) {
+            if (usable) { ff[i] = candidate[i]; held = false; }
+            else {
+                /* Repeated PID shadow seed calls must never recursively copy
+                 * the previous PI output into a new feedforward baseline. */
+                if (!seed) return spServoReject(s, SP_SERVO_STATE);
+                ff[i] = applied[i]; seeded = true;
+            }
+        } else ff[i] = held ? s->feedforward[i] : candidate[i];
+        error[i] = s->omegaCommand[i] - measured[i];
+        proportional[i] = s->config.kp * error[i];
+        const float rawI = seed ? applied[i] - ff[i] - proportional[i] :
+            s->servoI[i] + s->config.ki * error[i] * s->config.dt;
+        if (!isfinite(error[i]) || !isfinite(proportional[i]) || !isfinite(rawI))
+            return spServoReject(s, SP_SERVO_NUMERIC);
+        integral[i] = spClamp(rawI, -s->config.integralLimit, s->config.integralLimit);
+        if (usable && held) {
+            recoveryTicks[i] = s->ffRecoveryTicks[i] < dwellTicks ?
+                (uint16_t)(s->ffRecoveryTicks[i] + 1u) : (uint16_t)dwellTicks;
+            if (recoveryTicks[i] >= dwellTicks) {
+                /* Preserve FF+I exactly within float tolerance. When I has no
+                 * room, recover only the FF increment that can be rebased;
+                 * clipping I after a full FF jump would not be bumpless. */
+                const float delta = spClamp(candidate[i] - ff[i],
+                    integral[i] - s->config.integralLimit,
+                    integral[i] + s->config.integralLimit);
+                ff[i] += delta;
+                integral[i] = spClamp(integral[i] - delta, -s->config.integralLimit, s->config.integralLimit);
+                if (fabsf(candidate[i] - ff[i]) <= 0.0001f) {
+                    held = false; seeded = false; recoveryTicks[i] = 0;
+                    recoveries = spIncrement(recoveries);
+                }
+            }
+            if (held) { recoveringMask |= bit; reason[i] |= SP_FF_RECOVERY; }
+        }
+        if (!held && usable) seeded = false;
+        if (held) heldMask |= bit;
+        if (seeded) { seededMask |= bit; reason[i] |= SP_FF_SEEDED; }
+        if (held || status == SM_TRANSFER) degradedMask |= bit;
+        if ((degradedMask & bit) && !(s->ffDegradedMask & bit)) entries = spIncrement(entries);
+        validMask |= bit;
+        if (fabsf(integral[i]) >= s->config.integralLimit) iSaturatedMask |= bit;
+        float proposed = ff[i] + proportional[i] + integral[i];
+        if (!isfinite(ff[i]) || !isfinite(integral[i]) || !isfinite(proposed))
+            return spServoReject(s, SP_SERVO_NUMERIC);
+        if (s->config.countSlewPerSec > 0) {
+            const float delta = s->config.countSlewPerSec * s->config.dt;
+            proposed = spClamp(proposed, applied[i] - delta, applied[i] + delta);
+        }
+        count[i] = spClamp(proposed, low, high);
+    }
+    uint8_t aggregate = 0;
+    for (unsigned i = 0; i < 4; i++) aggregate |= reason[i];
+    s->voltageSupport = aggregate; s->servoLow = low; s->servoHigh = high;
+    memcpy(s->feedforward, ff, sizeof(ff)); memcpy(s->feedforwardCandidate, candidate, sizeof(candidate));
+    memcpy(s->servoError, error, sizeof(error)); memcpy(s->servoP, proportional, sizeof(proportional));
+    memcpy(s->servoI, integral, sizeof(integral)); memcpy(s->servoCount, count, sizeof(count));
+    memcpy(s->servoApplied, applied, sizeof(s->servoApplied));
+    memcpy(s->ffModelFlags, modelFlags, sizeof(modelFlags)); memcpy(s->ffReason, reason, sizeof(reason));
+    memcpy(s->ffRecoveryTicks, recoveryTicks, sizeof(recoveryTicks));
+    s->ffValidMask = validMask; s->ffCandidateMask = candidateMask; s->ffDegradedMask = degradedMask;
+    s->ffHeldMask = heldMask; s->ffRecoveringMask = recoveringMask; s->ffSeededMask = seededMask;
+    s->ffDegradedEntries = entries; s->ffRecoveries = recoveries; s->servoISaturatedMask = iSaturatedMask;
+    if (iSaturatedMask) s->servoISaturationTicks = spIncrement(s->servoISaturationTicks);
+    s->servoFailure = SP_SERVO_OK; s->servoPending = true;
+    return true;
+}
+void spTrack(spState_t *s,const float actual[4])
+{
+    if(!s||!s->initialized||!s->servoPending||!actual||!spFinite(actual,4))return;
+    for(unsigned i=0;i<4;i++){
+        /* Include candidate's own count/slew limiting as well as final blend.
+         * Using raw FF+P+I avoids losing the internal saturation discrepancy. */
+        float raw=s->feedforward[i]+s->servoP[i]+s->servoI[i];
+        s->servoI[i]=spClamp(s->servoI[i]+spClamp(s->config.kaw*s->config.dt,0,1)*(actual[i]-raw),-s->config.integralLimit,s->config.integralLimit);
+        s->servoApplied[i]=actual[i];
+    }
+    uint8_t saturated = 0;
+    for (unsigned i=0;i<4;i++) if (fabsf(s->servoI[i]) >= s->config.integralLimit)
+        saturated |= (uint8_t)(1u << i);
+    if (saturated && !s->servoISaturatedMask)
+        s->servoISaturationTicks = spIncrement(s->servoISaturationTicks);
+    s->servoISaturatedMask = saturated;
+    s->servoPending=false;
+}
diff --git a/src/main/flight/sanity_indi/paper_core.h b/src/main/flight/sanity_indi/paper_core.h
new file mode 100644
index 0000000..e7b2681
--- /dev/null
+++ b/src/main/flight/sanity_indi/paper_core.h
@@ -0,0 +1,102 @@
+/* Pure measured-speed S7--S10 controller. SI units in the adapter's physical FRD.
+ * No clocks, allocation, hardware or global state. Call Observe once per admitted
+ * fixed-grid tick. Matching H does not establish matching sensor-path delay.
+ */
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+#define SP_MODEL_ID UINT32_C(0x50494e31)
+#define SP_SOLVER_EXACT 0u
+#define SP_SOLVER_BOUNDED 1u
+#define SP_SOLVER_ITERATION 2u
+#define SP_SOLVER_SINGULAR 3u
+#define SP_SOLVER_NUMERIC 4u
+#define SP_SOLVER_NONE 255u
+/* SIPS v2/trace v2 model-reason bits. These describe confidence, not bounds. */
+#define SP_FF_UNSUPPORTED 1u
+#define SP_FF_TRANSFER 2u
+#define SP_FF_RECOVERY 4u
+#define SP_FF_SEEDED 8u
+#define SP_FF_INVALID 128u
+/* Selected bounded engineering transfer: always reported degraded, never
+ * promoted to empirical support. Override=0 retains held-only comparison. */
+#ifndef SP_FF_ACCEPT_TRANSFER
+#define SP_FF_ACCEPT_TRANSFER 1
+#endif
+#define SP_FF_RECOVERY_DWELL_S 0.050f
+#define SP_SERVO_OK 0u
+#define SP_SERVO_STATE 1u
+#define SP_SERVO_INPUT 2u
+#define SP_SERVO_MODEL 3u
+#define SP_SERVO_NUMERIC 4u
+/* Legacy helper support values retained for source compatibility only. */
+#define SP_SUPPORT_IN_HULL 0u
+#define SP_SUPPORT_VOLTAGE_CLAMP 1u
+#define SP_SUPPORT_THRUST_CLAMP 2u
+#define SP_SUPPORT_COUNT_CLAMP 4u
+/* kp count/(rad/s), ki count/rad, kaw 1/s; integralLimit counts,
+ * countSlewPerSec counts/s. Candidate gains are engineering settings only.
+ * g1 physical [N,Nm,Nm,Nm]/(rad/s)^2, g2 [N,Nm,Nm,Nm]/(rad/s^2).
+ * rowScale gives physical characteristic row magnitudes; priority is separate.
+ */
+typedef struct {
+    float dt, cutoffHz, inertia[3], g1[4][4], g2[4][4];
+    float omegaMin[4], omegaMax[4], rowScale[4], priority[4];
+    unsigned maxIterations, warmupTicks;
+    float kp, ki, kaw, integralLimit, countSlewPerSec;
+} spConfig_t;
+typedef struct {
+    spConfig_t config;
+    bool initialized, ready;
+    unsigned ticks;
+    float omegaFiltered[4], bodyFiltered[3], alphaFiltered[3];
+    float tauFiltered[3], tauDesired[3], g2Torque[3];
+    float omegaCommand[4], omegaPrevious[4], residual[4];
+    float servoError[4], servoP[4], servoI[4], feedforward[4], servoCount[4];
+    uint8_t solverCode, saturatedMask, voltageSupport;
+    unsigned iterations;
+    /* Direct form II transposed low-pass states, 4 rotor then 3 body. */
+    float b0, b1, b2, a1, a2, filterZ1[7], filterZ2[7];
+    float observedOmegaPrevious[4], observedBodyPrevious[3];
+    float servoApplied[4], servoLow, servoHigh;
+    bool observed, allocated, servoPending;
+    /* All FF histories commit only after every motor calculation succeeds.
+     * degraded includes admitted TRANSFER; held identifies frozen baselines.
+     * seeded persists until a supported/accepted model fully replaces the seed. */
+    float feedforwardCandidate[4];
+    uint16_t ffModelFlags[4], ffRecoveryTicks[4];
+    uint8_t ffReason[4], ffValidMask, ffCandidateMask, ffDegradedMask;
+    uint8_t ffHeldMask, ffRecoveringMask, ffSeededMask, servoISaturatedMask;
+    uint8_t servoFailure;
+    uint32_t ffDegradedEntries, ffRecoveries, servoISaturationTicks;
+
+} spState_t;
+bool spInit(spState_t *state, const spConfig_t *config);
+/* Retains validated config/filter coefficients; invalidates every history. */
+void spReset(spState_t *state);
+/* Rebase all synchronized observation channels after one bounded timing event.
+ * Retains ready/ticks and servo/model histories only for an already-ready
+ * controller; zero derivatives and restart H from the current valid samples.
+ * No observation integration or allocator history may span the invalid grid. */
+bool spReseedObservation(spState_t *state, const float omega[4], const float bodyFRD[3]);
+bool spObserve(spState_t *state, const float omega[4], const float bodyFRD[3]);
+/* residual = requested minus attained, in [N,Nm,Nm,Nm]. Does not commit history.
+ * Returns true for exact or bounded stationary approximation only. */
+bool spAllocate(spState_t *state, float collective, const float alphaFRD[3]);
+void spCommit(spState_t *state);
+/* Uses UNFILTERED measured mechanical rad/s, live delivered FC volts. Each
+ * successful call proposes counts and integrates speed error once. seed tracks
+ * applied counts without integrating error. It does NOT repeatedly seed held FF.
+ * Track must follow final selection
+ * exactly once; it performs min(dt*kaw,1)*(actual-(FF+P+I)) external reset, including
+ * internal limits as well as final output blending. */
+bool spServo(spState_t *state, const float measuredOmega[4], float voltage,
+    float lowCount, float highCount, const float appliedCount[4], bool seed);
+void spTrack(spState_t *state, const float actualCount[4]);
+/* Direct speed-model compatibility helper for motor 0. Returns a model FF
+ * only when empirically supported (or explicitly admitted engineering transfer)
+ * and within caller physical bounds. Never raises a target to a hull edge.
+ * The servo itself evaluates confidence separately from final physical bounds. */
+uint32_t spFeedforwardModelFingerprint(void);
+bool spFeedforward(float omega, float voltage, float low, float high,
+    float *count, uint8_t *support);
diff --git a/src/main/flight/sanity_indi/paper_model.h b/src/main/flight/sanity_indi/paper_model.h
