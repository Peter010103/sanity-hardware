+/* The session transport mutex outlives transport TX mutexes. Peer-loss clear
+ * already holds it. Hold the same recursive mutex from type lookup through send
+ * so an executor cannot destroy TX resources between lookup and acquisition.
+ * DROP must never wait for a reconnect or another sender. */
+static z_result_t _z_send_transport_lock(_z_session_t *zn, z_congestion_control_t policy) {
+#if Z_FEATURE_MULTI_THREAD == 1
+    return policy == Z_CONGESTION_CONTROL_BLOCK ? _z_mutex_rec_lock(&zn->_mutex_transport)
+                                               : _z_mutex_rec_try_lock(&zn->_mutex_transport);
+#else
+    _ZP_UNUSED(zn); _ZP_UNUSED(policy);
+    return _Z_RES_OK;
+#endif
+}
