diff --git a/src/main/flight/sanity_force/core.c b/src/main/flight/sanity_force/core.c
new file mode 100644
index 0000000..d1e91bc
--- /dev/null
+++ b/src/main/flight/sanity_force/core.c
@@ -0,0 +1,200 @@
+/* GPL-3.0-or-later. See core.h. No control outputs or arming dependencies. */
+#include "platform.h"
+#include <math.h>
+#include <string.h>
+#include "core.h"
+
+static void clearEstimate(sfOutput_t *out)
+{
+    out->valid = false;
+    memset(out->externalN, 0, sizeof(out->externalN));
+    memset(out->specificForce, 0, sizeof(out->specificForce));
+    out->thrustN = 0.0f;
+}
+
+static void invalidate(sfState_t *s, sfReason_e reason)
+{
+    clearEstimate(&s->output);
+    s->output.reason = reason;
+    s->initialized = false;
+}
+
+bool sfInit(sfState_t *s, const sfConfig_t *c)
+{
+    if (!s || !c) return false;
+    memset(s, 0, sizeof(*s));
+    s->output.enabled = true;
+    s->output.reason = SF_CONFIG;
+    if (!isfinite(c->massKg) || c->massKg < 0.01f || c->massKg > 2.0f ||
+        !isfinite(c->maxOmega) || c->maxOmega <= 0.0f || c->maxOmega > 20000.0f ||
+        !isfinite(c->cutoffHz) || c->cutoffHz < 1.0f || c->cutoffHz > 100.0f ||
+        c->periodUs < 100 || c->periodUs > 10000 ||
+        c->maxGapUs < c->periodUs || c->maxGapUs > 20000 ||
+        c->maxRpmAgeUs < 100 || c->maxRpmAgeUs > 20000 ||
+        c->maxAccAgeUs < c->periodUs || c->maxAccAgeUs > 20000 ||
+        c->warmupUs > 1000000 || c->accDelayUs > 5000 || c->rpmDelayUs > 5000 ||
+        c->cutoffHz * (float)c->maxGapUs * 1e-6f >= 0.4f) return false;
+    float norm = 0.0f;
+    for (unsigned a = 0; a < 3; ++a) {
+        if (!isfinite(c->thrustAxis[a]) || !isfinite(c->imuOffsetM[a]) ||
+            fabsf(c->imuOffsetM[a]) > 0.2f || !isfinite(c->accBias[a]) ||
+            fabsf(c->accBias[a]) > 2.0f) return false;
+        norm += c->thrustAxis[a] * c->thrustAxis[a];
+    }
+    if (fabsf(norm - 1.0f) > 0.001f) return false;
+    for (unsigned m = 0; m < 4; ++m) {
+        if (!isfinite(c->kT[m]) || c->kT[m] <= 0.0f || c->kT[m] > 0.001f) return false;
+    }
+    s->config = *c;
+    s->output.reason = SF_RPM_MISSING;
+    return true;
+}
+
+void sfRecordRpm(sfState_t *s, unsigned motor, uint32_t readTimeUs, float omega)
+{
+    if (!s || motor >= 4) return;
+    const uint32_t stamp = readTimeUs - s->config.rpmDelayUs;
+    if (s->count[motor]) {
+        const unsigned last = (s->head[motor] + SF_HISTORY - 1) % SF_HISTORY;
+        if ((int32_t)(stamp - s->rpm[motor][last].timeUs) <= 0) return;
+    }
+    s->rpm[motor][s->head[motor]] = (sfRpmSample_t){stamp, omega};
+    s->head[motor] = (s->head[motor] + 1) % SF_HISTORY;
+    if (s->count[motor] < SF_HISTORY) s->count[motor]++;
+}
+
+static bool sampleAt(const sfState_t *s, unsigned motor, uint32_t timeUs, sfRpmSample_t *sample)
+{
+    for (unsigned i = 0; i < s->count[motor]; ++i) {
+        const unsigned index = (s->head[motor] + SF_HISTORY - 1 - i) % SF_HISTORY;
+        if ((int32_t)(timeUs - s->rpm[motor][index].timeUs) >= 0) {
+            *sample = s->rpm[motor][index];
+            return true;
+        }
+    }
+    return false;
+}
+
+static void cross(const float a[3], const float b[3], float out[3])
+{
+    out[0] = a[1]*b[2] - a[2]*b[1];
+    out[1] = a[2]*b[0] - a[0]*b[2];
+    out[2] = a[0]*b[1] - a[1]*b[0];
+}
+
+void sfRejectSample(sfState_t *s, uint32_t readUs, sfReason_e reason)
+{
+    s->output.sequence++;
+    s->output.haveSample = true;
+    s->output.readTimeUs = readUs;
+    s->output.sampleTimeUs = readUs - s->config.accDelayUs;
+    s->output.rpmMask = 0;
+    s->output.intervalUs = 0;
+    for (unsigned m = 0; m < 4; ++m) s->output.rpmAgeUs[m] = UINT16_MAX;
+    invalidate(s, reason);
+}
+
+void sfUpdate(sfState_t *s, uint32_t readUs, const float measured[3], const float omega[3], bool calibrated)
+{
+    sfOutput_t *out = &s->output;
+    out->sequence++;
+    out->readTimeUs = readUs;
+    out->sampleTimeUs = readUs - s->config.accDelayUs;
+    out->haveSample = true;
+    out->rpmMask = 0;
+    out->intervalUs = s->initialized ? out->sampleTimeUs - s->previousSampleUs : s->config.periodUs;
+    for (unsigned m = 0; m < 4; ++m) out->rpmAgeUs[m] = UINT16_MAX;
+    if (!calibrated) { invalidate(s, SF_CALIBRATING); return; }
+    for (unsigned a = 0; a < 3; ++a) {
+        if (!isfinite(measured[a]) || !isfinite(omega[a])) { invalidate(s, SF_NUMERIC); return; }
+    }
+    if (out->intervalUs < s->config.periodUs / 4 || out->intervalUs > s->config.maxGapUs) {
+        invalidate(s, SF_TIMING); return;
+    }
+    float thrust = 0.0f;
+    sfReason_e reason = SF_OK;
+    for (unsigned m = 0; m < 4; ++m) {
+        sfRpmSample_t sample;
+        if (!sampleAt(s, m, out->sampleTimeUs, &sample)) { reason = SF_RPM_MISSING; continue; }
+        const uint32_t age = out->sampleTimeUs - sample.timeUs;
+        out->rpmAgeUs[m] = age < UINT16_MAX ? age : UINT16_MAX;
+        if (age > s->config.maxRpmAgeUs) { reason = SF_RPM_STALE; continue; }
+        if (!isfinite(sample.omega)) { reason = SF_NUMERIC; continue; }
+        if (sample.omega < 0.0f || sample.omega > s->config.maxOmega) { reason = SF_RPM_RANGE; continue; }
+        out->rpmMask |= 1U << m;
+        thrust += s->config.kT[m] * sample.omega * sample.omega;
+    }
+    if (out->rpmMask != 15) { invalidate(s, reason); return; }
+    const float dt = (float)out->intervalUs * 1e-6f;
+    float alpha[3], angular[3], radial[3], tmp[3];
+    for (unsigned a = 0; a < 3; ++a) {
+        alpha[a] = s->initialized ? (omega[a] - s->previousOmega[a]) / dt : 0.0f;
+        s->previousOmega[a] = omega[a];
+    }
+    // r points from CoM to IMU. These sensor-point accelerations are removed
+    // before interpreting the accelerometer as a CoM specific-force sample.
+    cross(alpha, s->config.imuOffsetM, angular);
+    cross(omega, s->config.imuOffsetM, tmp);
+    cross(omega, tmp, radial);
+    float input[4];
+    for (unsigned a = 0; a < 3; ++a) input[a] = measured[a] - s->config.accBias[a] - angular[a] - radial[a];
+    input[3] = thrust;
+    // Shared coefficients and state resets ensure identical signal filtering.
+    // Actual inter-read intervals set the coefficients; sensor group delays
+    // are separate calibrated parameters, not inferred from software timing.
+    const float k = tanf(3.14159265358979323846f * s->config.cutoffHz * dt);
+    const float norm = 1.0f / (1.0f + 1.4142135623730951f*k + k*k);
+    const float b0 = k*k*norm, b1 = 2.0f*b0, a1 = 2.0f*(k*k - 1.0f)*norm;
+    const float a2 = (1.0f - 1.4142135623730951f*k + k*k)*norm;
+    if (!s->initialized) {
+        s->firstGoodUs = out->sampleTimeUs;
+        for (unsigned a = 0; a < 4; ++a) s->filter[a] = (sfFilter_t){input[a], input[a], input[a], input[a]};
+        s->initialized = true;
+    }
+    s->previousSampleUs = out->sampleTimeUs;
+    float filtered[4];
+    for (unsigned a = 0; a < 4; ++a) {
+        sfFilter_t *f = &s->filter[a];
+        filtered[a] = b0*input[a] + b1*f->x1 + b0*f->x2 - a1*f->y1 - a2*f->y2;
+        f->x2=f->x1; f->x1=input[a]; f->y2=f->y1; f->y1=filtered[a];
+        if (!isfinite(filtered[a])) { invalidate(s, SF_NUMERIC); return; }
+    }
+    out->thrustN = filtered[3];
+    for (unsigned a = 0; a < 3; ++a) {
+        out->specificForce[a] = filtered[a];
+        out->externalN[a] = s->config.massKg*filtered[a] - out->thrustN*s->config.thrustAxis[a];
+        if (!isfinite(out->externalN[a])) { invalidate(s, SF_NUMERIC); return; }
+    }
+    out->valid = out->sampleTimeUs - s->firstGoodUs >= s->config.warmupUs;
+    out->reason = out->valid ? SF_OK : SF_WARMUP;
+}
+
+sfOutput_t sfSnapshot(const sfState_t *s, uint32_t now)
+{
+    sfOutput_t out = s->output;
+    out.exportTimeUs = now;
+    if (!out.haveSample) { out.reason = SF_ACC_MISSING; clearEstimate(&out); }
+    else if (now - out.readTimeUs > s->config.maxAccAgeUs) { out.reason = SF_ACC_STALE; clearEstimate(&out); }
+    return out;
+}
+
+static void put16(uint8_t *p, uint16_t value) { p[0]=value; p[1]=value>>8; }
+static void put32(uint8_t *p, uint32_t value) { for (unsigned i=0;i<4;++i) p[i]=value>>(8*i); }
+static void putFloat(uint8_t *p, float value) { uint32_t bits; memcpy(&bits, &value, 4); put32(p, bits); }
+
+void sfEncode(const sfOutput_t *out, uint8_t packet[SF_PACKET_SIZE])
+{
+    memset(packet, 0, SF_PACKET_SIZE);
+    packet[0]=SF_PACKET_VERSION; packet[1]=SF_FRAME_BF_ACCEL_NATIVE;
+    packet[2]=(out->enabled ? 1 : 0) | (out->valid ? 2 : 0) | (out->haveSample ? 4 : 0);
+    packet[3]=out->reason;
+    put32(packet+4, out->sequence); put32(packet+8, out->readTimeUs);
+    put32(packet+12, out->sampleTimeUs); put32(packet+16, out->exportTimeUs);
+    put32(packet+20, out->intervalUs); packet[24]=out->rpmMask; packet[25]=out->sourceKind;
+    put16(packet+26, out->lastRuntimeUs); put16(packet+28, out->maxRuntimeUs);
+    for (unsigned m=0;m<4;++m) put16(packet+32+2*m, out->rpmAgeUs[m]);
+    for (unsigned a=0;a<3;++a) putFloat(packet+40+4*a, out->externalN[a]);
+    putFloat(packet+52, out->thrustN);
+    for (unsigned a=0;a<3;++a) putFloat(packet+56+4*a, out->specificForce[a]);
+    // Bytes 30-31,68-71 are reserved and must remain zero in version 1.
+}
diff --git a/src/main/flight/sanity_force/core.h b/src/main/flight/sanity_force/core.h
new file mode 100644
index 0000000..2632361
--- /dev/null
+++ b/src/main/flight/sanity_force/core.h
@@ -0,0 +1,59 @@
+/* Sanity logging-only external-force observer. GPL-3.0-or-later.
+ * Residual follows arXiv:2501.18802, section 4.4. This is total external
+ * non-gravitational force (including cable, drag and fixture reactions).
+ * Coordinates are the aligned Betaflight accelerometer/body axes, NOT world.
+ */
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+
+#define SF_MOTORS 4
+#define SF_HISTORY 32
+#define SF_PACKET_SIZE 72
+#define SF_PACKET_VERSION 1
+#define SF_FRAME_BF_ACCEL_NATIVE 1
+#define SF_SOURCE_READ_MIDPOINT 0
+#define SF_SOURCE_GYRO_DMA_DRDY 1
+#define SF_MSP_COMMAND 0x7f10 /* Experimental, read-only; not an upstream MSP ID. */
+
+typedef enum {
+    SF_OK = 0, SF_DISABLED, SF_CONFIG, SF_CALIBRATING, SF_RPM_MISSING,
+    SF_RPM_STALE, SF_TIMING, SF_NUMERIC, SF_WARMUP, SF_ACC_STALE, SF_RPM_RANGE,
+    SF_ACC_MISSING
+} sfReason_e;
+
+typedef struct {
+    float massKg, kT[4], maxOmega, cutoffHz;
+    float thrustAxis[3], imuOffsetM[3], accBias[3];
+    uint32_t periodUs, maxGapUs, maxRpmAgeUs, maxAccAgeUs, warmupUs;
+    uint32_t accDelayUs, rpmDelayUs;
+} sfConfig_t;
+
+typedef struct {
+    uint32_t sequence, readTimeUs, sampleTimeUs, exportTimeUs, intervalUs;
+    float externalN[3], thrustN, specificForce[3];
+    uint16_t rpmAgeUs[4], lastRuntimeUs, maxRuntimeUs;
+    uint8_t rpmMask, reason, sourceKind;
+    bool enabled, valid, haveSample;
+} sfOutput_t;
+
+typedef struct { uint32_t timeUs; float omega; } sfRpmSample_t;
+typedef struct { float x1, x2, y1, y2; } sfFilter_t;
+typedef struct {
+    sfConfig_t config;
+    sfRpmSample_t rpm[4][SF_HISTORY];
+    uint8_t head[4], count[4];
+    sfFilter_t filter[4];
+    float previousOmega[3];
+    uint32_t previousSampleUs, firstGoodUs;
+    bool initialized;
+    sfOutput_t output;
+} sfState_t;
+
+bool sfInit(sfState_t *state, const sfConfig_t *config);
+void sfRecordRpm(sfState_t *state, unsigned motor, uint32_t readTimeUs, float omegaRadS);
+void sfUpdate(sfState_t *state, uint32_t readTimeUs, const float specificForce[3],
+              const float bodyRate[3], bool calibrated);
+void sfRejectSample(sfState_t *state, uint32_t readTimeUs, sfReason_e reason);
+sfOutput_t sfSnapshot(const sfState_t *state, uint32_t nowUs);
+void sfEncode(const sfOutput_t *output, uint8_t packet[SF_PACKET_SIZE]);
diff --git a/src/main/flight/sanity_indi.c b/src/main/flight/sanity_indi.c
new file mode 100644
index 0000000..19331f2
--- /dev/null
+++ b/src/main/flight/sanity_indi.c
@@ -0,0 +1,461 @@
+/* Sanity experimental PID/INDI authority manager. GPL-3.0-or-later.
+ * PID always executes. INDI observes applied outputs at the full control rate;
+ * the standby allocator is decimated. No automatic engagement after arming.
+ */
+#include "platform.h"
+#ifdef USE_SANITY_INDI
+#include <math.h>
+#include <string.h>
+#include "build/debug.h"
+#include "common/axis.h"
+#include "common/maths.h"
+#include "config/config.h"
+#include "drivers/time.h"
+#include "drivers/dshot.h"
+#include "drivers/dshot_command.h"
+#include "drivers/motor.h"
+#include "fc/core.h"
+#include "fc/rc.h"
+#include "fc/runtime_config.h"
+#include "flight/imu.h"
+#include "flight/mixer.h"
+#include "flight/mixer_init.h"
+#include "flight/pid.h"
+#include "pg/motor.h"
+#include "pg/sanity_indi.h"
+#include "sensors/battery.h"
+#include "sensors/gyro.h"
+#include "rx/rx.h"
+#include "sanity_indi.h"
+#include "sanity_indi/core.h"
+#include "sanity_indi/model.h"
+#include "sanity_indi/paper_adapter.h"
+
+static FAST_DATA_ZERO_INIT siState_t controller;
+static FAST_DATA_ZERO_INIT sanityIndiStatus_t status;
+static FAST_DATA_ZERO_INIT shState_t supervisor;
+static sanityIndiConfig_t settings;
+static bool configured, configValid, haveApplied, armedLast, haveCandidate;
+static float applied[4], candidate[4];
+static uint32_t cycleStart, previousStep, guardAt, stableAt, badTakeoffAt, slewUntil;
+static uint8_t budgetOverruns;
+static uint32_t configuredPeriodUs, shadowElapsedUs;
+static struct {
+    uint32_t cycles, deadlineMisses, lateIntervals, over90, logDrops, intervalUs;
+    uint32_t sampleUs, maxSampleUs, filterUs, maxFilterUs, sampleOverruns, filterOverruns;
+    uint32_t histogram[6];
+} timing;
+static int32_t trace[SI_TRACE_COUNT];
+static bool traceRecording;
+static const float traceScale[SI_TRACE_COUNT] = {
+#define SI_TRACE_FIELD(id, name, index, scale) (float)(scale),
+#include "sanity_indi/trace_fields.def"
+#undef SI_TRACE_FIELD
+};
+
+bool sanityIndiTraceEnabled(void) { return sanityIndiConfig()->traceEnabled == 1; }
+void sanityIndiTraceSetRecording(bool enabled) { traceRecording=enabled; }
+void sanityIndiRecordLogDrop(void) { timing.logDrops++; }
+void sanityIndiRecordTaskTime(bool filtering, uint32_t elapsedUs, uint32_t budgetUs)
+{
+    if (filtering) {
+        timing.filterUs=elapsedUs;
+        if (elapsedUs>timing.maxFilterUs) timing.maxFilterUs=elapsedUs;
+        if (budgetUs && elapsedUs>=budgetUs) timing.filterOverruns++;
+    } else {
+        timing.sampleUs=elapsedUs;
+        if (elapsedUs>timing.maxSampleUs) timing.maxSampleUs=elapsedUs;
+        if (budgetUs && elapsedUs>=budgetUs) timing.sampleOverruns++;
+    }
+}
+/* Restrict non-counter values to +/-1e9 so differencing cannot overflow int32.
+ * Invalid/clipped values are explicit flags; never silently round NaN to a number. */
+static void traceValue(unsigned field, float value)
+{
+    const float scaled=value*traceScale[field];
+    if (!isfinite(scaled)) { trace[SI_TRACE_FLAGS]|=SI_TRACE_NONFINITE; trace[field]=0; }
+    else if (scaled>1e9f || scaled<-1e9f) {
+        trace[SI_TRACE_FLAGS]|=SI_TRACE_CLIPPED; trace[field]=scaled>0 ? 1000000000 : -1000000000;
+    } else trace[field]=lrintf(scaled);
+}
+void sanityIndiTraceSnapshot(int32_t fields[SI_TRACE_COUNT])
+{
+    /* Timing is the previous completed PID cycle: Blackbox writes before CycleEnd. */
+    trace[SI_TRACE_CYCLE_US]=status.cycleUs; trace[SI_TRACE_CYCLES]=(int32_t)timing.cycles;
+    trace[SI_TRACE_DEADLINES]=(int32_t)timing.deadlineMisses;
+    trace[SI_TRACE_LATE_INTERVALS]=(int32_t)timing.lateIntervals;
+    trace[SI_TRACE_BUDGET_90]=(int32_t)timing.over90; trace[SI_TRACE_LOG_DROPS]=(int32_t)timing.logDrops;
+    trace[SI_TRACE_SAMPLE_US]=timing.sampleUs; trace[SI_TRACE_FILTER_US]=timing.filterUs;
+    for (unsigned i=0;i<6;++i) trace[SI_TRACE_HISTOGRAM0+i]=(int32_t)timing.histogram[i];
+    memcpy(fields,trace,sizeof(trace));
+}
+
+static float bounded(float value, float low, float high)
+{
+    return fminf(high, fmaxf(low, value));
+}
+
+/* supported() restricts this adapter to non-3D DShot. These are the same
+ * affine endpoints as dshotConvertToExternal/FromExternal, without the
+ * telemetry-oriented integer PWM conversion in the feedback path. Keep the
+ * continuous demand for actuator estimation, blending and PID external reset;
+ * the motor driver still quantizes the physical DShot packet normally. */
+static float sanityMotorToExternalFloat(float motorValue)
+{
+    if (!isfinite(motorValue)) return NAN;
+    if (motorValue < DSHOT_MIN_THROTTLE) return 1000.0f;
+    return scaleRangef(motorValue, DSHOT_MIN_THROTTLE, DSHOT_MAX_THROTTLE, 1001.0f, 2000.0f);
+}
+
+static float sanityMotorFromExternalFloat(float count)
+{
+    if (!isfinite(count)) return NAN;
+    if (count <= 1000.0f) return DSHOT_CMD_MOTOR_STOP;
+    return scaleRangef(bounded(count, 1001.0f, 2000.0f), 1001.0f, 2000.0f, DSHOT_MIN_THROTTLE, DSHOT_MAX_THROTTLE);
+}
+
+static bool supported(void)
+{
+    return getMotorCount()==4 && mixerConfig()->mixerMode==MIXER_QUADX &&
+        !mixerRuntime.feature3dEnabled && isMotorProtocolDshot() &&
+        motorConfig()->dev.motorPwmProtocol==PWM_TYPE_DSHOT300 &&
+        motorConfig()->motorPoleCount==12 && motorConfig()->dev.useDshotTelemetry &&
+        currentPidProfile->thrustLinearization==0 && !currentPidProfile->use_integrated_yaw;
+}
+
+static void trackPidFromAppliedOutput(float outputMinimum, float outputRange, float pidMixScale)
+{
+    float target[3]={0};
+    const float yawSign=mixerConfig()->yaw_motors_reversed ? 1.0f : -1.0f;
+    for (unsigned m=0;m<4;++m) {
+        const float output=(motor[m]-outputMinimum)/outputRange*.25f*1000.0f;
+        target[0]+=output*mixerRuntime.currentMixer[m].roll;
+        target[1]+=output*mixerRuntime.currentMixer[m].pitch;
+        target[2]+=output*mixerRuntime.currentMixer[m].yaw*yawSign;
+    }
+    // The projection above is AFTER mixer attenuation. PID I/P/D/F sums
+    // are BEFORE it. Without this inverse, external reset stores the
+    // attenuated value and the next cycle attenuates it again, including
+    // the PID-only tracking tail after the return blend reaches zero.
+    for (unsigned a=0;a<3;++a) target[a]/=pidMixScale;
+    pidTrackSanityOutput(target);
+}
+
+static bool configure(void)
+{
+    sanityIndiConfig_t controlSettings=*sanityIndiConfig();
+    controlSettings.traceEnabled=0; // Logging changes never reseed control dynamics.
+    const sanityIndiConfig_t *c=&controlSettings;
+    if (configured && configuredPeriodUs==targetPidLooptime && memcmp(c,&settings,sizeof(settings))==0) return configValid;
+    /* Never reseed controller dynamics under an in-flight period change. A reboot
+     * or disarmed reinitialization is required for a different timing profile. */
+    if (configured && configuredPeriodUs!=targetPidLooptime && ARMING_FLAG(ARMED)) { configValid=false; return false; }
+    settings=*c; configuredPeriodUs=targetPidLooptime; shadowElapsedUs=0;
+    configured=true; configValid=false; haveCandidate=false; stableAt=0;
+    if (!settings.enabled) return false;
+    if (settings.requestAux<1 || settings.requestAux>4 || !settings.shadowDenom || settings.shadowDenom>16 ||
+        settings.transitionMs<50 || settings.transitionMs>1000 || settings.entryDwellMs<100 ||
+        settings.entryDwellMs>3000 || settings.entryRateDps<5 || settings.entryRateDps>100 ||
+        settings.entryTiltDeg<2 || settings.entryTiltDeg>30 || settings.entryDeltaPercent<1 ||
+        settings.entryDeltaPercent>20 || !settings.outputStepPermille || settings.outputStepPermille>20 ||
+        settings.guardWindowMs<1000 || settings.guardWindowMs>30000 || settings.guardRateDps<100 ||
+        settings.guardRateDps>500 || settings.guardErrorDps<50 || settings.guardErrorDps>300 ||
+        settings.guardTimeMs<50 || settings.guardTimeMs>500) return false;
+    siConfig_t cfg={0}; cfg.dt=(float)targetPidLooptime*1e-6f;
+    cfg.cutoffHz=settings.syncCutoffHz; cfg.maxIterations=settings.maxIterations;
+    for (unsigned a=0;a<3;++a) cfg.rateGain[a]=(float)settings.rateGains[a]*.1f;
+    const float yawSign=mixerConfig()->yaw_motors_reversed ? 1.0f : -1.0f;
+    for (unsigned m=0;m<4;++m) {
+        cfg.motorTau[m]=(float)settings.motorTauMs[m]*.001f; cfg.axisWeight[m]=settings.axisWeights[m];
+        cfg.effectiveness[0][m]=1.0f/SI_MASS_KG;
+        cfg.effectiveness[1][m]=mixerRuntime.currentMixer[m].roll*SI_ARM_Y_M/SI_IXX;
+        cfg.effectiveness[2][m]=mixerRuntime.currentMixer[m].pitch*SI_ARM_X_M/SI_IYY;
+        cfg.effectiveness[3][m]=yawSign*mixerRuntime.currentMixer[m].yaw*SI_KQ/(SI_KT*SI_IZZ);
+    }
+    configValid=siInit(&controller,&cfg);
+    return configValid;
+}
+
+bool sanityIndiActive(void) { return status.active; }
+void sanityIndiUpdateArmingStatus(void)
+{
+    // Invalid experimental settings deny INDI, never healthy PID arming.
+    if (!ARMING_FLAG(ARMED)) unsetArmingDisabled(ARMING_DISABLED_SANITY_INDI);
+}
+void sanityIndiCycleStart(void) { cycleStart=micros(); }
+void sanityIndiCycleEnd(void)
+{
+    const uint32_t elapsed=micros()-cycleStart;
+    status.cycleUs=elapsed<UINT16_MAX ? elapsed : UINT16_MAX;
+    if (status.cycleUs>status.maxCycleUs) status.maxCycleUs=status.cycleUs;
+    timing.cycles++;
+    if (targetPidLooptime) {
+        if (elapsed>=targetPidLooptime) timing.deadlineMisses++;
+        if (elapsed>targetPidLooptime*9U/10U) timing.over90++;
+        const unsigned percent=elapsed*100U/targetPidLooptime;
+        unsigned bin=percent<=50 ? 0 : percent<=75 ? 1 : percent<=90 ? 2 : percent<=100 ? 3 : percent<=150 ? 4 : 5;
+        timing.histogram[bin]++;
+    }
+}
+
+static void criticalStop(uint8_t reason)
+{
+    status.guardTriggered=true; status.lastFault=reason; status.fault=reason;
+    status.active=false; supervisor.weight=0; supervisor.fault=reason;
+    supervisor.mode=SH_PID; supervisor.reason=reason; supervisor.lastFault=reason;
+    setArmingDisabled(ARMING_DISABLED_RUNAWAY_TAKEOFF);
+    disarm(DISARM_REASON_RUNAWAY_TAKEOFF);
+    for (unsigned m=0;m<getMotorCount();++m) motor[m]=mixerRuntime.disarmMotorOutput;
+}
+
+void sanityIndiApply(timeUs_t now, float minimum, float maximum, float collectiveOutput,
+    float outputMinimum, float outputRange, float pidMixScale, bool motorStop)
+{
+    sanityPaperHousekeeping(now);
+    if (sanityPaperBackend(ARMING_FLAG(ARMED))==1) {
+        const uint32_t paperDt=previousStep ? (uint32_t)(now-previousStep) : targetPidLooptime;
+        previousStep=now;timing.intervalUs=paperDt;
+        if(targetPidLooptime&&paperDt>targetPidLooptime*3U/2U)timing.lateIntervals++;
+        sanityPaperApply(now,minimum,maximum,collectiveOutput,outputMinimum,outputRange,pidMixScale,motorStop,&status);
+        return;
+    }
+    const uint32_t start=micros();
+    siInput_t in={0}; bool observed=false, allocated=false;
+    const bool armed=ARMING_FLAG(ARMED);
+    const bool enabled=sanityIndiConfig()->enabled;
+    status.sequence++; status.enabled=enabled; status.armed=armed;
+    const bool pidMixInvertible=isfinite(pidMixScale) && pidMixScale>0.0f;
+    status.supported=supported() && pidMixInvertible; status.requestAux=sanityIndiConfig()->requestAux;
+    status.requested=status.requestAux>=1 && status.requestAux<=4 &&
+        rcData[4+status.requestAux-1]>1700;
+    uint32_t dt=previousStep ? (uint32_t)(now-previousStep) : targetPidLooptime;
+    previousStep=now;
+    timing.intervalUs=dt;
+    if (targetPidLooptime && dt>targetPidLooptime*3U/2U) timing.lateIntervals++;
+    if (armed && enabled && supervisor.weight>0.0f && status.cycleUs>targetPidLooptime*9U/10U) {
+        if (budgetOverruns<3) budgetOverruns++;
+    } else budgetOverruns=0;
+    if (armed && !armedLast) {
+        guardAt=now; badTakeoffAt=0; stableAt=0; status.guardTriggered=false;
+        if (configured) siResetRuntime(&controller);
+        haveCandidate=false;
+    }
+    armedLast=armed;
+    if (!haveApplied) {
+        for (unsigned m=0;m<4;++m) applied[m]=motor[m];
+        haveApplied=true;
+    }
+    uint8_t reason=SH_OK, fault=0;
+    const bool validConfig=configure();
+    float maxRate=0, maxError=0;
+    for (unsigned a=0;a<3;++a) {
+        const float rate=gyro.gyroADCf[a], setpoint=getSetpointRate(a);
+        status.rate[a]=DEGREES_TO_RADIANS(rate);
+        if (enabled && armed && (!isfinite(rate) || !isfinite(setpoint))) {
+            criticalStop(SH_NUMERIC); goto finish;
+        }
+        maxRate=fmaxf(maxRate,fabsf(rate)); maxError=fmaxf(maxError,fabsf(setpoint-rate));
+    }
+    status.rpmMask=0;
+    for (unsigned m=0;m<4;++m) {
+        const uint32_t stamp=dshotTelemetryState.motorState[m].sanityErpmTimestampUs;
+        if (stamp && (uint32_t)(micros()-stamp)<=(uint32_t)sanityIndiConfig()->rpmTimeoutMs*1000U)
+            status.rpmMask |= 1U<<m;
+        if (enabled && armed && !isfinite(motor[m])) { criticalStop(SH_NUMERIC); goto finish; }
+    }
+    const bool modeOk=!(flightModeFlags & ~FAILSAFE_MODE) &&
+        !isFlipOverAfterCrashActive() && !isLaunchControlActive();
+    if (!enabled) reason=SH_DISABLED;
+    else if (!validConfig || !status.supported || !(outputRange>0.0f)) reason=SH_CONFIG;
+    else if (!modeOk) reason=SH_MODE;
+    else if (!rxIsReceivingSignal()) reason=SH_RX;
+    else if (dt<targetPidLooptime/2U || dt>3U*targetPidLooptime) reason=SH_TIMING;
+    else if (budgetOverruns>=3) reason=SH_TIMING;
+    else if (settings.requireRpm && status.rpmMask!=15) reason=SH_RPM;
+    else if (motorStop || rcData[THROTTLE]<SI_RC_MIN) reason=SH_IDLE;
+    status.requestedThrustN=siRequestedCollective(rcData[THROTTLE],getBatteryVoltage()*10U);
+    const float low=sanityMotorToExternalFloat(minimum), high=sanityMotorToExternalFloat(maximum);
+    if (enabled && validConfig && status.supported && low>=1100.0f && high<=2000.0f && low<high) {
+        in.collectiveN=4.0f*siMotorForce(sanityMotorToExternalFloat(collectiveOutput),8.0f);
+        status.collectiveN=in.collectiveN;
+        for (unsigned a=0;a<3;++a) {
+            in.rate[a]=DEGREES_TO_RADIANS(gyro.sanityIndiGyro[a]);
+            in.filteredRate[a]=status.rate[a]; in.setpoint[a]=DEGREES_TO_RADIANS(getSetpointRate(a));
+        }
+        for (unsigned m=0;m<4;++m) {
+            in.forceMin[m]=siMotorForce(low,8.0f); in.forceMax[m]=siMotorForce(high,8.0f);
+            const float previous=sanityMotorToExternalFloat(applied[m]);
+            in.forceCommandedPrevious[m]=previous<1001.0f ? 0.0f : siMotorForce(fmaxf(low,previous),8.0f);
+        }
+        observed=siObserve(&controller,&in);
+        // shadowDenom is in reference 500us ticks. Preserve 2kHz behavior and
+        // average standby allocation rate when the PID profile is 1kHz.
+        shadowElapsedUs+=targetPidLooptime;
+        const uint32_t shadowPeriodUs=(uint32_t)settings.shadowDenom*500U;
+        const bool shadowDue=targetPidLooptime==500 ? status.sequence%settings.shadowDenom==0 : shadowElapsedUs>=shadowPeriodUs;
+        if (shadowDue) shadowElapsedUs%=shadowPeriodUs;
+        if (observed && ((reason==SH_OK && !supervisor.fault && (supervisor.weight>0 || status.requested)) || shadowDue)) {
+            allocated=siAllocate(&controller,&in) && controller.solverExit!=1;
+            haveCandidate=allocated;
+            if (allocated) {
+                for (unsigned m=0;m<4;++m) candidate[m]=controller.force[m];
+                status.steps++;
+            }
+        }
+        if (!observed) { reason=SH_NUMERIC; haveCandidate=false; }
+        else if (!haveCandidate) reason=SH_ALLOCATOR;
+    } else if (enabled && reason==SH_OK) reason=SH_CONFIG;
+    status.shadowValid=haveCandidate;
+    if (supervisor.weight>0 && reason!=SH_OK) {
+        if (reason!=SH_MODE && reason!=SH_IDLE && reason!=SH_DISABLED) fault=reason;
+        if (!fault) supervisor.sawRequestLow=false;
+    }
+    // Abnormal initial response protection uses actual gyro/error and motor
+    // spread for BOTH controllers, independent of pidData.Sum. Genuine kill,
+    // RX failsafe and the normal Betaflight runaway check are retained.
+    if (enabled && armed && validConfig && (uint32_t)(now-guardAt)<(uint32_t)settings.guardWindowMs*1000U) {
+        float minMotor=motor[0], maxMotor=motor[0];
+        for (unsigned m=1;m<4;++m) { minMotor=fminf(minMotor,motor[m]); maxMotor=fmaxf(maxMotor,motor[m]); }
+        const bool abnormal=maxRate>settings.guardRateDps && maxError>settings.guardErrorDps &&
+            (maxMotor-minMotor)>0.05f*outputRange && rcData[THROTTLE]>=SI_RC_MIN;
+        if (!abnormal) badTakeoffAt=0;
+        else if (!badTakeoffAt) badTakeoffAt=now;
+        else if ((uint32_t)(now-badTakeoffAt)>=(uint32_t)settings.guardTimeMs*1000U) {
+            criticalStop(SH_TAKEOFF); goto finish;
+        }
+    }
+    status.trackingError=0.0f;
+    if (haveCandidate) for (unsigned m=0;m<4;++m) {
+        const float pidForce=siMotorForce(sanityMotorToExternalFloat(motor[m]),8.0f);
+        status.trackingError=fmaxf(status.trackingError,fabsf(pidForce-candidate[m])/SI_MOTOR_REFERENCE_FORCE_N);
+    }
+    // Motion/tilt/output agreement and timing are ENTRY gates, not reasons to
+    // abandon a healthy active controller during its commanded maneuver.
+    uint8_t entryReason=reason;
+    if (entryReason==SH_OK && supervisor.weight==0.0f) {
+        if (maxRate>settings.entryRateDps || getCosTiltAngle()<cosf(DEGREES_TO_RADIANS(settings.entryTiltDeg))) entryReason=SH_MOTION;
+        else if (status.trackingError>(float)settings.entryDeltaPercent*.01f) entryReason=SH_TRACKING;
+        else if (status.cycleUs>targetPidLooptime*8U/10U) entryReason=SH_TIMING;
+        if (entryReason==SH_OK) {
+            if (!stableAt) stableAt=now;
+            if ((uint32_t)(now-stableAt)<(uint32_t)settings.entryDwellMs*1000U) entryReason=SH_WARMUP;
+        } else stableAt=0;
+    }
+    status.readyUs=stableAt ? (uint32_t)(now-stableAt) : 0;
+    status.eligible=entryReason==SH_OK;
+    const float oldWeight=supervisor.weight;
+    const shInput_t policy={.armed=armed,.enabled=enabled,.request=status.requested,
+        .eligible=status.eligible,.reason=entryReason,.fault=fault,.nowUs=now,
+        .dtUs=dt<targetPidLooptime/2U || dt>3U*targetPidLooptime ? targetPidLooptime : dt,
+        .transitionUs=(uint32_t)(validConfig ? settings.transitionMs : 200)*1000U};
+    shUpdate(&supervisor,&policy);
+    if (oldWeight==0.0f && supervisor.weight>0.0f) { guardAt=now; badTakeoffAt=0; }
+    if (oldWeight!=supervisor.weight) slewUntil=now+(uint32_t)settings.transitionMs*1000U;
+    if (armed && !motorStop && supervisor.weight>0.0f && outputRange>0.0f) {
+        const float weight=supervisor.weight;
+        for (unsigned m=0;m<4;++m) {
+            const float pidForce=siMotorForce(sanityMotorToExternalFloat(motor[m]),8.0f);
+            // On an invalid allocator, fade from the last actually applied
+            // output; never mix a stale/NaN proposed controller output.
+            const float indiForce=reason==SH_OK && haveCandidate ? candidate[m] :
+                siMotorForce(sanityMotorToExternalFloat(applied[m]),8.0f);
+            float count;
+            if (!siMotorInverse((1.0f-weight)*pidForce+weight*indiForce,8.0f,low,high,&count)) {
+                criticalStop(SH_NUMERIC); goto finish;
+            }
+            motor[m]=bounded(sanityMotorFromExternalFloat(count),minimum,maximum);
+        }
+    }
+    if (armed && !motorStop && rcData[THROTTLE]>=SI_RC_MIN && (int32_t)(slewUntil-now)>0 && validConfig) {
+        // CLI step is permille per reference 500us, preserving as-flown 2kHz
+        // slew and the same physical slew speed at 1kHz.
+        const float delta=(float)settings.outputStepPermille*.001f*outputRange*((float)targetPidLooptime/500.0f);
+        for (unsigned m=0;m<4;++m) motor[m]=bounded(motor[m],fmaxf(minimum,applied[m]-delta),fminf(maximum,applied[m]+delta));
+    }
+    if (armed && (supervisor.weight>0.0f || (int32_t)(slewUntil-now)>0) && outputRange>0.0f && pidMixInvertible) {
+        trackPidFromAppliedOutput(outputMinimum,outputRange,pidMixScale);
+    }
+finish:
+    for (unsigned m=0;m<4;++m) applied[m]=motor[m];
+    status.active=supervisor.weight>0.0f && ARMING_FLAG(ARMED);
+    status.armed=ARMING_FLAG(ARMED);
+    status.weight=supervisor.weight; status.mode=supervisor.mode; status.reason=supervisor.reason;
+    status.fault=supervisor.fault; status.lastFault=supervisor.lastFault;
+    status.transitions=supervisor.transitions; status.fallbacks=supervisor.fallbacks;
+    status.solverExit=controller.solverExit; status.iterations=controller.iterations;
+    status.saturatedMask=controller.saturatedMask;
+    const uint32_t elapsed=micros()-start;
+    status.lastRuntimeUs=elapsed<UINT16_MAX ? elapsed : UINT16_MAX;
+    if (status.lastRuntimeUs>status.maxRuntimeUs) status.maxRuntimeUs=status.lastRuntimeUs;
+    if (sanityIndiTraceEnabled() || traceRecording) {
+        trace[SI_TRACE_SEQUENCE]=(int32_t)status.sequence;
+        trace[SI_TRACE_FLAGS]=(observed?SI_TRACE_OBSERVED:0)|(allocated?SI_TRACE_ALLOCATED:0)|(haveCandidate?SI_TRACE_CANDIDATE_VALID:0);
+        trace[SI_TRACE_INTERVAL]=dt; trace[SI_TRACE_PERIOD]=targetPidLooptime;
+        trace[SI_TRACE_MODE]=status.mode; trace[SI_TRACE_FAULT]=status.fault;
+        trace[SI_TRACE_SOLVER]=status.solverExit; trace[SI_TRACE_ITERATIONS]=status.iterations;
+        trace[SI_TRACE_SATURATED]=status.saturatedMask; traceValue(SI_TRACE_WEIGHT,status.weight);
+        traceValue(SI_TRACE_COLLECTIVE,status.collectiveN); traceValue(SI_TRACE_MIX_GAIN,pidMixScale);
+        for (unsigned a=0;a<3;++a) {
+            traceValue(SI_TRACE_SETPOINT0+a,in.setpoint[a]); traceValue(SI_TRACE_EARLY0+a,in.rate[a]);
+            traceValue(SI_TRACE_FINAL0+a,status.rate[a]);
+            traceValue(SI_TRACE_NU0+a,controller.config.rateGain[a]*(in.setpoint[a]-in.filteredRate[a]));
+            traceValue(SI_TRACE_ALPHA0+a,controller.filteredAlpha[a]);
+        }
+        const uint32_t traceNow=micros();
+        for (unsigned m=0;m<4;++m) {
+            traceValue(SI_TRACE_PREVIOUS_FORCE0+m,in.forceCommandedPrevious[m]);
+            traceValue(SI_TRACE_MODEL_FORCE0+m,controller.modelForce[m]);
+            traceValue(SI_TRACE_FILTERED_FORCE0+m,controller.filteredForce[m]);
+            traceValue(SI_TRACE_DELTA0+m,controller.delta[m]);
+            traceValue(SI_TRACE_APPLIED0+m,sanityMotorToExternalFloat(applied[m]));
+            const uint32_t stamp=dshotTelemetryState.motorState[m].sanityErpmTimestampUs;
+            trace[SI_TRACE_RPM_AGE0+m]=stamp ? (int32_t)fminf((float)(traceNow-stamp),1e9f) : 1000000000;
+        }
+    }
+    DEBUG_SET(DEBUG_SANITY_INDI,0,status.mode);
+    DEBUG_SET(DEBUG_SANITY_INDI,1,lrintf(status.weight*1000.0f));
+    DEBUG_SET(DEBUG_SANITY_INDI,2,status.reason);
+    DEBUG_SET(DEBUG_SANITY_INDI,3,status.rpmMask);
+    DEBUG_SET(DEBUG_SANITY_INDI,4,status.cycleUs);
+    DEBUG_SET(DEBUG_SANITY_INDI,5,status.maxCycleUs);
+    DEBUG_SET(DEBUG_SANITY_INDI,6,status.lastRuntimeUs);
+    DEBUG_SET(DEBUG_SANITY_INDI,7,status.fault);
+}
+
+const sanityIndiStatus_t *sanityIndiStatus(void) { return &status; }
+static void put16(uint8_t *p,uint16_t v) { p[0]=v; p[1]=v>>8; }
+static void put32(uint8_t *p,uint32_t v) { for (unsigned i=0;i<4;++i) p[i]=v>>(8*i); }
+static void putFloat(uint8_t *p,float value) { uint32_t bits; memcpy(&bits,&value,4); put32(p,bits); }
+void sanityIndiEncodeTiming(uint8_t packet[SANITY_INDI_TIMING_SIZE])
+{
+    memset(packet,0,SANITY_INDI_TIMING_SIZE); memcpy(packet,"SIT1",4); packet[4]=1;
+    const bool paperSelected = sanityPaperTraceSelected();
+    const bool selectedValid = paperSelected ? sanityPaperConfigured() : configValid;
+    const bool selectedInitialized = paperSelected ? sanityPaperInitialized() : controller.initialized;
+    packet[5]=(sanityIndiTraceEnabled()?1:0)|(selectedValid?2:0)|(selectedInitialized?4:0);
+    put32(packet+8,micros()); put32(packet+12,status.sequence); put32(packet+16,targetPidLooptime);
+    put32(packet+20,timing.cycles); put32(packet+24,status.cycleUs); put32(packet+28,status.maxCycleUs);
+    put32(packet+32,timing.deadlineMisses); put32(packet+36,timing.lateIntervals); put32(packet+40,timing.over90);
+    put32(packet+44,timing.logDrops); put32(packet+48,timing.intervalUs);
+    put32(packet+52,timing.sampleUs); put32(packet+56,timing.maxSampleUs);
+    put32(packet+60,timing.filterUs); put32(packet+64,timing.maxFilterUs);
+    put32(packet+68,timing.sampleOverruns); put32(packet+72,timing.filterOverruns);
+}
+void sanityIndiEncode(uint8_t packet[SANITY_INDI_PACKET_SIZE])
+{
+    memset(packet,0,SANITY_INDI_PACKET_SIZE);
+    packet[0]=1; packet[1]=status.mode;
+    packet[2]=(status.enabled?1:0)|(status.requested?2:0)|(status.eligible?4:0)|
+        (status.fault?8:0)|(status.armed?16:0)|(status.guardTriggered?32:0)|(status.supported?64:0);
+    packet[3]=status.reason; packet[4]=status.lastFault; packet[5]=status.rpmMask;
+    packet[6]=status.saturatedMask; packet[7]=status.solverExit;
+    put32(packet+8,micros()); put32(packet+12,status.sequence); put32(packet+16,status.steps);
+    put16(packet+20,status.transitions); put16(packet+22,status.fallbacks);
+    putFloat(packet+24,status.weight); put16(packet+28,status.lastRuntimeUs); put16(packet+30,status.maxRuntimeUs);
+    put16(packet+32,status.cycleUs); put16(packet+34,status.maxCycleUs); putFloat(packet+36,status.trackingError);
+    put16(packet+40,status.iterations); packet[42]=status.requestAux;
+    put32(packet+56,status.readyUs); putFloat(packet+60,status.collectiveN);
+    for (unsigned a=0;a<3;++a) putFloat(packet+64+4*a,status.rate[a]);
+    packet[76]=status.fault;
+}
+#endif
diff --git a/src/main/flight/sanity_indi.h b/src/main/flight/sanity_indi.h
