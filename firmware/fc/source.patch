diff --git a/src/main/flight/sanity_indi/rate_feedforward.c b/src/main/flight/sanity_indi/rate_feedforward.c
new file mode 100644
index 0000000..748696f
--- /dev/null
+++ b/src/main/flight/sanity_indi/rate_feedforward.c
@@ -0,0 +1,51 @@
+#include "rate_feedforward.h"
+#include <math.h>
+#include <string.h>
+bool srFfInit(srFfState_t *s, const srFfConfig_t *c)
+{
+    if (!s || !c) return false;
+    memset(s,0,sizeof(*s));
+    if (!isfinite(c->dt) || (fabsf(c->dt-.001f)>1e-8f && fabsf(c->dt-.0005f)>1e-8f)
+        || !isfinite(c->cutoffHz) || c->cutoffHz<1 || c->cutoffHz>100) return false;
+    for (unsigned a=0;a<3;a++)
+        if (!isfinite(c->gain[a]) || c->gain[a]<0 || c->gain[a]>1
+            || !isfinite(c->limit[a]) || c->limit[a]<1 || c->limit[a]>500) return false;
+    s->config=*c;
+    const float x=6.2831853071795864769f*c->cutoffHz*c->dt;
+    s->coefficient=x/(1+x); /* PT1 backward Euler, evaluated only on configuration. */
+    s->configured=true;
+    return true;
+}
+void srFfReset(srFfState_t *s)
+{
+    if (!s) return;
+    if (s->primed && s->resets!=UINT32_MAX) s->resets++;
+    memset(s->previous,0,sizeof(s->previous));
+    memset(s->raw,0,sizeof(s->raw));
+    memset(s->derivative,0,sizeof(s->derivative));
+    memset(s->alpha,0,sizeof(s->alpha));
+    s->primed=false;s->seeded=false;s->clippedMask=0;
+}
+bool srFfUpdate(srFfState_t *s, const float demand[3], bool active)
+{
+    if (!s) return false;
+    if (!active) {srFfReset(s);return true;}
+    if (!s->configured || !demand) {srFfReset(s);return false;}
+    for (unsigned a=0;a<3;a++)
+        if (!isfinite(demand[a])) {srFfReset(s);return false;}
+    s->seeded=false;s->clippedMask=0;
+    if (!s->primed) {
+        memcpy(s->previous,demand,sizeof(s->previous));s->primed=true;s->seeded=true;
+        return true;
+    }
+    for (unsigned a=0;a<3;a++) {
+        const float raw=(demand[a]-s->previous[a])/s->config.dt;
+        const float filtered=s->derivative[a]+s->coefficient*(raw-s->derivative[a]);
+        const float alpha=s->config.gain[a]*filtered;
+        if (!isfinite(raw) || !isfinite(filtered) || !isfinite(alpha)) {srFfReset(s);return false;}
+        s->previous[a]=demand[a];s->raw[a]=raw;s->derivative[a]=filtered;
+        s->alpha[a]=fminf(s->config.limit[a],fmaxf(-s->config.limit[a],alpha));
+        if (fabsf(alpha)>s->config.limit[a]) s->clippedMask|=1U<<a;
+    }
+    return true;
+}
diff --git a/src/main/flight/sanity_indi/rate_feedforward.h b/src/main/flight/sanity_indi/rate_feedforward.h
new file mode 100644
index 0000000..8df3b32
--- /dev/null
+++ b/src/main/flight/sanity_indi/rate_feedforward.h
@@ -0,0 +1,24 @@
+/* Physical FRD rate-setpoint acceleration feedforward; GPL-3.0-or-later.
+ * This is reference differentiation, not measured gyro differentiation and
+ * not Betaflight's F/boost scaling. H and the motor-speed servo are separate.
+ */
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+typedef struct {
+    float dt, cutoffHz, gain[3], limit[3]; /* seconds, Hz, dimensionless, rad/s² */
+} srFfConfig_t;
+typedef struct {
+    srFfConfig_t config;
+    float coefficient, previous[3], raw[3], derivative[3], alpha[3];
+    uint32_t resets;
+    uint8_t clippedMask;
+    bool configured, primed, seeded;
+} srFfState_t;
+bool srFfInit(srFfState_t *, const srFfConfig_t *);
+void srFfReset(srFfState_t *);
+/* Call once per admitted nominal control tick. Inactive or rejected gaps
+ * clear history. First healthy tick seeds demand and contributes zero.
+ * Healthy compatibility PID-shadow ticks also advance reference history.
+ */
+bool srFfUpdate(srFfState_t *, const float demandFrd[3], bool active);
diff --git a/src/main/flight/sanity_indi/speed_model.h b/src/main/flight/sanity_indi/speed_model.h
new file mode 100644
index 0000000..facad38
--- /dev/null
+++ b/src/main/flight/sanity_indi/speed_model.h
@@ -0,0 +1,101 @@
+/* GENERATED offline by model/generate_header.py. Direct mechanical speed model.
+ * omega=1000*(V/7.5)*(c0+c1*q+c2*q^2+c3*q^3), q=(count-1550)/450.
+ * One common coefficient vector; motor-specific/cohort-separated support hulls.
+ * Numerical box is an engineering transfer domain, NOT independent validation.
+ * No STOP/startup law. Status is mandatory: unsupported inversion NEVER clamps
+ * a target into support or intersects a measurement hull with servo constraints.
+ * Caller owns transfer admission, hard count bounds, slew, hold/seed and STOP.
+ */
+#pragma once
+#include <math.h>
+#include <stdint.h>
+#include <stdbool.h>
+typedef enum { SM_TRUSTED_IN_SUPPORT=0, SM_TRANSFER=1, SM_UNSUPPORTED=2, SM_INVALID=3 } smStatus_t;
+#define SM_FLAG_OUTSIDE_MEASURED UINT16_C(1)
+#define SM_FLAG_COUNT_TRANSFER UINT16_C(2)
+#define SM_FLAG_VOLTAGE_TRANSFER UINT16_C(4)
+#define SM_FLAG_COUNT_DOMAIN UINT16_C(8)
+#define SM_FLAG_VOLTAGE_DOMAIN UINT16_C(16)
+#define SM_FLAG_TARGET_LOW UINT16_C(32)
+#define SM_FLAG_TARGET_HIGH UINT16_C(64)
+#define SM_FLAG_NUMERIC UINT16_C(128)
+#define SM_COUNT_MIN 1100.0f
+#define SM_COUNT_MAX 2000.0f
+#define SM_VOLTAGE_MIN 6.5f
+#define SM_VOLTAGE_MAX 8.3f
+#define SM_MODEL_FINGERPRINT UINT32_C(0x67dde095)
+/* Fingerprint: first32 SHA256 bits of canonical sorted compact JSON containing
+ * name, coefficients, numerical_domain and support_polygons. Full SHA256:
+ * 67dde09500f0f1c59cb2e7ce9cfce1809386b013fa1349a86dd980c779264939 */
+#define SM_MEASURED_COUNT_MIN 1150.f
+#define SM_MEASURED_COUNT_MAX 2000.f
+#define SM_MEASURED_VOLTAGE_MIN 6.963888889f
+#define SM_MEASURED_VOLTAGE_MAX 8.19f
+static const float smCoefficients[4]={3.616675218f,2.514912276f,-0.6271723871f,0.3887789977f};
+static const float smHullVertices[][2]={{1150.f,8.186470588f},{1150.f,7.58f},{1380.43662f,7.461666667f},{1550.f,7.503125f},{1550.f,8.089411765f},{1500.f,8.110625f},{1350.f,8.16f},{1250.f,8.18f},{2000.f,6.983684211f},{2000.f,7.520555556f},{1950.f,7.670526316f},{1900.f,7.720555556f},{1850.f,7.77f},{1800.f,7.816111111f},{1650.f,7.947222222f},{1600.f,7.984736842f},{1550.f,8.020555556f},{1500.f,8.052941176f},{1401.054795f,7.697777778f},{1410.347222f,7.513888889f},{1430.794521f,7.285555556f},{1470.945205f,7.204444444f},{1479.375f,7.197368421f},{1550.f,7.502941176f},{1550.f,8.084375f},{1500.f,8.103125f},{1350.f,8.155625f},{1250.f,8.18f},{1150.f,8.18f},{1150.f,7.580625f},{1383.873239f,7.461666667f},{2000.f,6.992631579f},{2000.f,7.511666667f},{1950.f,7.661052632f},{1850.f,7.772222222f},{1800.f,7.824210526f},{1700.f,7.92f},{1600.f,7.99f},{1500.f,8.053684211f},{1397.541667f,7.906666667f},{1409.77027f,7.514444444f},{1434.638889f,7.471111111f},{1150.f,8.19f},{1150.f,7.58f},{1383.760563f,7.461666667f},{1550.f,7.501875f},{1550.f,8.0875f},{1350.f,8.16f},{1250.f,8.18f},{1475.041667f,7.197368421f},{2000.f,6.966842105f},{2000.f,7.504444444f},{1950.f,7.642105263f},{1900.f,7.71f},{1850.f,7.759444444f},{1700.f,7.9f},{1600.f,7.977777778f},{1500.f,8.045789474f},{1395.236111f,7.906666667f},{1412.567568f,7.514444444f},{1150.f,8.183529412f},{1150.f,7.58f},{1388.507042f,7.461666667f},{1550.f,7.500625f},{1550.f,8.081875f},{1450.f,8.1225f},{1350.f,8.16f},{1250.f,8.18f},{2000.f,6.963888889f},{2000.f,7.493888889f},{1950.f,7.646666667f},{1900.f,7.711111111f},{1850.f,7.760555556f},{1750.f,7.851111111f},{1700.f,7.896111111f},{1600.f,7.979444444f},{1500.f,8.047368421f},{1407.630137f,7.697777778f},{1413.291667f,7.513888889f},{1433.60274f,7.285555556f},{1472.69863f,7.204444444f},{1480.319444f,7.197368421f}};
+/* motor, first vertex, vertex count; every hull is counterclockwise. */
+static const unsigned short smPolygons[][3]={{0,0,8},{0,8,15},{1,23,8},{1,31,11},{2,42,7},{2,49,11},{3,60,8},{3,68,14}};
+
+static inline float smRaw(float count,float voltage)
+{
+    float q=(count-1550.0f)/450.0f;
+    return (1000.0f*(voltage/7.5f))*(((smCoefficients[3]*q+smCoefficients[2])*q+smCoefficients[1])*q+smCoefficients[0]);
+}
+static inline bool smParametersValid(void)
+{
+    for(unsigned i=0;i<4;i++)if(!isfinite(smCoefficients[i]))return false;
+    float a=3.0f*smCoefficients[3],b=2.0f*smCoefficients[2],c=smCoefficients[1];
+    float d0=a-b+c,d1=a+b+c,minDerivative=fminf(d0,d1);
+    if(fabsf(a)>1e-12f){float vertex=-b/(2.0f*a);if(vertex>-1.0f&&vertex<1.0f)minDerivative=fminf(minDerivative,(a*vertex+b)*vertex+c);}
+    return minDerivative>0.0f && isfinite(smRaw(SM_COUNT_MIN,SM_VOLTAGE_MIN)) && smRaw(SM_COUNT_MIN,SM_VOLTAGE_MIN)>0.0f && isfinite(smRaw(SM_COUNT_MAX,SM_VOLTAGE_MAX));
+}
+static inline smStatus_t smSupport(float count,float voltage,unsigned motor,uint16_t *flags)
+{
+    if(!flags)return SM_INVALID;
+    *flags=0;
+    if(motor>=4u||!isfinite(count)||!isfinite(voltage)||voltage<=0.0f||!smParametersValid()){*flags=SM_FLAG_NUMERIC;return SM_INVALID;}
+    if(count<SM_COUNT_MIN||count>SM_COUNT_MAX)*flags|=SM_FLAG_COUNT_DOMAIN;
+    if(voltage<SM_VOLTAGE_MIN||voltage>SM_VOLTAGE_MAX)*flags|=SM_FLAG_VOLTAGE_DOMAIN;
+    if(*flags)return SM_UNSUPPORTED;
+    for(unsigned p=0;p<sizeof(smPolygons)/sizeof(smPolygons[0]);p++){
+        if(smPolygons[p][0]!=motor)continue;
+        unsigned first=smPolygons[p][1],n=smPolygons[p][2];bool inside=true;
+        for(unsigned j=0;j<n;j++){
+            const float *a=smHullVertices[first+j],*b=smHullVertices[first+(j+1u)%n];
+            float cross=(b[0]-a[0])*(voltage-a[1])-(b[1]-a[1])*(count-a[0]);
+            if(cross < -0.001f){inside=false;break;}
+        }
+        if(inside)return SM_TRUSTED_IN_SUPPORT;
+    }
+    *flags=SM_FLAG_OUTSIDE_MEASURED;
+    if(count<SM_MEASURED_COUNT_MIN||count>SM_MEASURED_COUNT_MAX)*flags|=SM_FLAG_COUNT_TRANSFER;
+    if(voltage<SM_MEASURED_VOLTAGE_MIN||voltage>SM_MEASURED_VOLTAGE_MAX)*flags|=SM_FLAG_VOLTAGE_TRANSFER;
+    return SM_TRANSFER;
+}
+static inline smStatus_t smEval(float count,float voltage,unsigned motor,float *omega,uint16_t *flags)
+{
+    if(!omega||!flags)return SM_INVALID;
+    *omega=0.0f;
+    smStatus_t status=smSupport(count,voltage,motor,flags);
+    if(status==SM_INVALID||status==SM_UNSUPPORTED)return status;
+    float value=smRaw(count,voltage);
+    if(!isfinite(value)||value<=0.0f){*flags|=SM_FLAG_NUMERIC;return SM_INVALID;}
+    *omega=value;return status;
+}
+static inline smStatus_t smInverse(float omega,float voltage,unsigned motor,float *count,uint16_t *flags)
+{
+    if(!count||!flags)return SM_INVALID;
+    *count=0.0f;*flags=0;
+    if(!isfinite(omega)||omega<0.0f||!isfinite(voltage)||voltage<=0.0f||motor>=4u||!smParametersValid()){*flags=SM_FLAG_NUMERIC;return SM_INVALID;}
+    if(voltage<SM_VOLTAGE_MIN||voltage>SM_VOLTAGE_MAX){*flags=SM_FLAG_VOLTAGE_DOMAIN;return SM_UNSUPPORTED;}
+    float low=SM_COUNT_MIN,high=SM_COUNT_MAX,minSpeed=smRaw(low,voltage),maxSpeed=smRaw(high,voltage);
+    if(!isfinite(minSpeed)||!isfinite(maxSpeed)||minSpeed<=0.0f||minSpeed>=maxSpeed){*flags=SM_FLAG_NUMERIC;return SM_INVALID;}
+    if(omega<minSpeed){*flags=SM_FLAG_TARGET_LOW;return SM_UNSUPPORTED;}
+    if(omega>maxSpeed){*flags=SM_FLAG_TARGET_HIGH;return SM_UNSUPPORTED;}
+    for(unsigned i=0;i<26u;i++){float mid=0.5f*(low+high);if(smRaw(mid,voltage)<omega)low=mid;else high=mid;}
+    float candidate=0.5f*(low+high);
+    if(!isfinite(candidate)){*flags=SM_FLAG_NUMERIC;return SM_INVALID;}
+    smStatus_t status=smSupport(candidate,voltage,motor,flags);
+    if(status==SM_TRUSTED_IN_SUPPORT||status==SM_TRANSFER)*count=candidate;
+    return status;
+}
diff --git a/src/main/flight/sanity_indi/supervisor.c b/src/main/flight/sanity_indi/supervisor.c
new file mode 100644
index 0000000..be93b64
--- /dev/null
+++ b/src/main/flight/sanity_indi/supervisor.c
@@ -0,0 +1,51 @@
+/* Policy changes authority; emergency disarm is handled by the flight adapter.
+ * Faults inhibit re-engagement until disarm. A low request must be observed
+ * after arming, so reboot/stale AUX-high cannot engage INDI at takeoff.
+ * GPL-3.0-or-later.
+ */
+#include "platform.h"
+#include <math.h>
+#include "supervisor.h"
+
+void shUpdate(shState_t *s, const shInput_t *in)
+{
+    if (!in->armed) {
+        s->weight=0.0f; s->mode=SH_PID; s->reason=SH_DISARMED;
+        s->fault=0; s->armedLast=false; s->sawRequestLow=false; s->requestLast=false;
+        return;
+    }
+    if (!s->armedLast) {
+        s->armedLast=true; s->weight=0.0f; s->mode=SH_PID;
+        s->sawRequestLow=false; s->requestLast=false;
+    }
+    if (!in->request) s->sawRequestLow=true;
+    if (in->fault && !s->fault) {
+        s->fault=in->fault; s->lastFault=in->fault;
+        if (s->weight>0.0f) s->fallbacks++;
+    }
+    bool target=false;
+    if (!in->enabled) s->reason=SH_DISABLED;
+    else if (s->fault) s->reason=s->fault;
+    else if (!in->request) s->reason=SH_OK;
+    else if (!s->sawRequestLow) s->reason=SH_REQUEST_RESET;
+    else if (s->weight>0.0f && s->mode!=SH_TO_PID && in->eligible) target=true;
+    else if (s->weight==0.0f && !s->requestLast && in->eligible) target=true;
+    else if (s->mode==SH_TO_INDI && in->eligible) target=true;
+    else s->reason=in->eligible ? SH_REQUEST_RESET : in->reason;
+    // A denied engagement requires a deliberate low/high retry. An active
+    // controller may continue while health is good; transient entry gates
+    // (settled rate/attitude) are not applied after it gains authority.
+    if (target) {
+        s->reason=SH_OK;
+        if (s->weight==0.0f) s->transitions++;
+    }
+    const float step=in->transitionUs ? (float)in->dtUs/(float)in->transitionUs : 0.0f;
+    if (!isfinite(step) || step<=0.0f || step>0.25f) {
+        s->fault=SH_TIMING; s->lastFault=SH_TIMING; s->reason=SH_TIMING;
+        target=false;
+    }
+    const float boundedStep=fminf(0.25f,fmaxf(0.0f,step));
+    s->weight=target ? fminf(1.0f,s->weight+boundedStep) : fmaxf(0.0f,s->weight-boundedStep);
+    s->mode=s->weight==0.0f ? SH_PID : s->weight==1.0f && target ? SH_INDI : target ? SH_TO_INDI : SH_TO_PID;
+    s->requestLast=in->request;
+}
