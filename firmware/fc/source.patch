@@ -0,0 +1,28 @@
+/* GENERATED by fc/core/generate_model.py. Composed approximate speed FF.
+ * kT/kQ/body inertia are static/provisional; rotor inertia is UNMEASURED.
+ * SP_ROTOR_INERTIA_DEFAULT=0 explicitly selects a reduced G2 model.
+ * Direct thrust map uses delivered FC voltage and joint measured hull only.
+ * Body reaction signs must be verified separately by the FC rotor table.
+ */
+#pragma once
+#define SP_MODEL_SOURCE_SHA256 "0360b6767a68b21dd7305d3d94ab9658805538c46c5d7cd03dc5441c4f5c6e03"
+#define SP_KT 3.275921725e-08f
+#define SP_KQ 1.588898828e-10f
+#define SP_MASS_KG 0.06947f
+#define SP_IXX 3.32e-05f
+#define SP_IYY 4.28e-05f
+#define SP_IZZ 5.43e-05f
+#define SP_ARM_X_M 0.0284610479f
+#define SP_ARM_Y_M 0.0284610479f
+#define SP_FF_COMMAND_CENTER 1550.f
+#define SP_FF_COMMAND_SCALE 450.f
+#define SP_FF_VOLTAGE_CENTER 7.5f
+#define SP_FF_VOLTAGE_SCALE 0.5f
+#define SP_FF_VOLTAGE_MIN 6.963888889f
+#define SP_FF_VOLTAGE_MAX 8.19f
+#define SP_ROTOR_INERTIA_DEFAULT 0.0f
+#define SP_FF_TERMS 15
+#define SP_FF_HULL_POINTS 10
+static const unsigned char spFfPowers[15][2] = {{0,0}, {1,0}, {0,1}, {2,0}, {1,1}, {0,2}, {3,0}, {2,1}, {1,2}, {0,3}, {4,0}, {3,1}, {2,2}, {1,3}, {0,4}};
+static const float spFfCoefficients[15] = {0.4351860671f, 0.5888277924f, 0.06950890425f, 0.01179402593f, 0.1056226229f, -0.001136124397f, -0.01749929088f, -0.06610857499f, -0.08317616643f, -0.0469042987f, 0.1154729693f, -0.09617320578f, 0.005125530352f, 0.05111545742f, 0.0336508287f};
+static const float spFfHull[10][2] = {{1950.f,7.670526316f}, {1550.f,8.089411765f}, {1500.f,8.110625f}, {1350.f,8.16f}, {1250.f,8.18f}, {1150.f,8.19f}, {1100.f,7.79f}, {1150.f,7.58f}, {2000.f,6.963888889f}, {2000.f,7.520555556f}};
diff --git a/src/main/flight/sanity_indi/paper_native.c b/src/main/flight/sanity_indi/paper_native.c
new file mode 100644
index 0000000..614a2df
--- /dev/null
+++ b/src/main/flight/sanity_indi/paper_native.c
@@ -0,0 +1,137 @@
+#include "paper_native.h"
+#include <math.h>
+#include <string.h>
+static uint32_t get32(const uint8_t *p) {
+  return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 |
+         p[3];
+}
+static float getFloat(const uint8_t *p) {
+  uint32_t u = get32(p);
+  float f;
+  memcpy(&f, &u, 4);
+  return f;
+}
+void spPut16(uint8_t *p, uint16_t v) {
+  p[0] = v >> 8;
+  p[1] = v;
+}
+void spPut32(uint8_t *p, uint32_t v) {
+  p[0] = v >> 24;
+  p[1] = v >> 16;
+  p[2] = v >> 8;
+  p[3] = v;
+}
+void spPut64(uint8_t *p, uint64_t v) {
+  spPut32(p, v >> 32);
+  spPut32(p + 4, v);
+}
+void spPutFloat(uint8_t *p, float f) {
+  uint32_t v;
+  memcpy(&v, &f, 4);
+  spPut32(p, v);
+}
+void spNativePoll(spNative_t *s, uint32_t now) {
+  if (s->accepted.claimed && (s->accepted.flags & 1) && !s->expired) {
+    const uint32_t duration = s->accepted.expiryUs - s->accepted.receiptUs;
+    if ((uint32_t)(now - s->accepted.receiptUs) >= duration) {
+      s->expired = true;
+      s->reason = 2;
+    }
+  }
+}
+bool spNativeValid(spNative_t *s, uint32_t now) {
+  spNativePoll(s, now);
+  return s->accepted.claimed && (s->accepted.flags & 1) && !s->expired;
+}
+static bool reject(spNative_t *s, uint16_t reason) {
+  s->rejected++;
+  s->reason = reason;
+  return false;
+}
+bool spNativeReceive(spNative_t *s, const uint8_t *p, unsigned n, uint32_t now,
+                     bool armed) {
+  if (n != 64 || memcmp(p, "SIP1", 4) || p[4] != 1 || p[5] != 3 || p[6] != 15 ||
+      p[30] != 1 || p[31] || get32(p + 32) != SP_NATIVE_MODEL)
+    return reject(s, 8);
+  spNativePoll(s, now);
+  const uint8_t flags = p[7];
+  if ((flags & ~3) || ((flags & 2) && !(flags & 1)))
+    return reject(s, 6);
+  spDemand_t d = {0};
+  d.flags = flags;
+  d.epoch = (uint64_t)get32(p + 8) << 32 | get32(p + 12);
+  d.session = get32(p + 16);
+  d.sequence = get32(p + 20);
+  const uint32_t remaining = get32(p + 24), ttl = (uint32_t)p[28] << 8 | p[29];
+  if (!d.epoch || !d.session || ttl < 1 || ttl > 1000 ||
+      ((flags & 1) && (!remaining || remaining > ttl)))
+    return reject(s, 6);
+  float f[7];
+  for (unsigned i = 0; i < 7; i++) {
+    f[i] = getFloat(p + 36 + 4 * i);
+    if (!isfinite(f[i]))
+      return reject(s, 6);
+    if (!flags && f[i] != 0)
+      return reject(s, 6);
+  }
+  if (f[0] < 0 || f[0] > 4)
+    return reject(s, 6);
+  for (unsigned i = 0; i < 3; i++)
+    if (fabsf(f[i + 1]) > 1000 || fabsf(f[i + 4]) > (i == 2 ? 2.6f : 2.3f))
+      return reject(s, 6);
+  const bool owner = s->accepted.claimed && d.epoch == s->accepted.epoch &&
+                     d.session == s->accepted.session;
+  if (!owner) {
+    if (flags || armed)
+      return reject(s, 9);
+    s->consumedSession = s->consumedSequence = s->consumedUs = 0;
+  } else {
+    const int32_t delta = (int32_t)(d.sequence - s->accepted.sequence);
+    if (!flags) { /* STOP never rolls back the replay watermark or reopens same
+                     ID. */
+      if (delta <= 0) {
+        s->accepted.flags = 0;
+        s->accepted.collective = 0;
+        memset(s->accepted.alpha, 0, sizeof(s->accepted.alpha));
+        memset(s->accepted.rate, 0, sizeof(s->accepted.rate));
+        s->accepted.expiryUs = now;
+        s->expired = true;
+        s->reason = 1;
+        return true;
+      }
+    }
+    if (delta ==
+        0) { /* A duplicate identity cannot mutate demand or revive lease. */
+      if (d.flags != s->accepted.flags || f[0] != s->accepted.collective)
+        return reject(s, 9);
+      for (unsigned i = 0; i < 3; i++)
+        if (f[i + 1] != s->accepted.alpha[i] || f[i + 4] != s->accepted.rate[i])
+          return reject(s, 9);
+      return true;
+    }
+    /* Owner stop is always honored even when the sequence/positive lease is
+     * stale. */
+    if (delta < 0 && flags)
+      return reject(s, 9);
+  }
+  d.collective = f[0];
+  for (unsigned i = 0; i < 3; i++) {
+    d.alpha[i] = f[i + 1];
+    d.rate[i] = f[i + 4];
+  }
+  d.claimed = true;
+  d.receiptUs = now;
+  d.expiryUs = now + remaining * 1000U;
+  s->accepted = d;
+  s->expired = !(flags & 1);
+  s->reason = flags ? 0 : 1;
+  return true;
+}
+void spNativeConsume(spNative_t *s, uint32_t now) {
+  if (s->consumedSession != s->accepted.session ||
+      s->consumedSequence != s->accepted.sequence) {
+    s->consumedSession = s->accepted.session;
+    s->consumedSequence = s->accepted.sequence;
+    s->consumedUs = now;
+  }
+}
diff --git a/src/main/flight/sanity_indi/paper_native.h b/src/main/flight/sanity_indi/paper_native.h
new file mode 100644
index 0000000..001a97c
--- /dev/null
+++ b/src/main/flight/sanity_indi/paper_native.h
@@ -0,0 +1,31 @@
+/* SIP1 payload owner. Big endian IEEE754, no native arming side effects. */
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+#define SP_NATIVE_SIZE 64
+#define SP_STATUS_SIZE 80
+#define SP_NATIVE_MSP 0x7f15
+#define SP_STATUS_MSP 0x7f16
+#define SP_NATIVE_MODEL UINT32_C(0x50494e31)
+typedef struct {
+  uint64_t epoch;
+  uint32_t session, sequence, receiptUs, expiryUs;
+  float collective, alpha[3], rate[3];
+  uint8_t flags;
+  bool claimed;
+} spDemand_t;
+typedef struct {
+  spDemand_t accepted;
+  uint32_t consumedSession, consumedSequence, consumedUs, rejected;
+  uint16_t reason;
+  bool expired;
+} spNative_t;
+bool spNativeReceive(spNative_t *s, const uint8_t *p, unsigned n, uint32_t now,
+                     bool armed);
+void spNativePoll(spNative_t *s, uint32_t now);
+bool spNativeValid(spNative_t *s, uint32_t now);
+void spNativeConsume(spNative_t *s, uint32_t now);
+void spPut16(uint8_t *, uint16_t);
+void spPut32(uint8_t *, uint32_t);
+void spPut64(uint8_t *, uint64_t);
+void spPutFloat(uint8_t *, float);
diff --git a/src/main/flight/sanity_indi/paper_rpm.c b/src/main/flight/sanity_indi/paper_rpm.c
new file mode 100644
index 0000000..c2008a4
--- /dev/null
+++ b/src/main/flight/sanity_indi/paper_rpm.c
@@ -0,0 +1,120 @@
+/* One producer: deferred dshot telemetry decode; bounded seqlock also protects
+ * deferred decode and housekeeping run in cooperative scheduler tasks.
+ * A slot publishes value+stamp+sequence together. */
+#include "paper_rpm.h"
+#include <math.h>
+#include <string.h>
+#define BARRIER() __asm__ volatile("" ::: "memory")
+void spRpmPoll(spRpmHistory_t *h, uint32_t now, uint32_t maxGap) {
+  for (unsigned m = 0; m < 4; m++) {
+    spRpmMotor_t *r = &h->motor[m];
+    if (r->count && !r->expired) {
+      const spRpmSample_t *last =
+          &r->sample[(r->head + SP_RPM_HISTORY - 1) % SP_RPM_HISTORY];
+      if ((int32_t)(now - last->stamp) >= 0 &&
+          (uint32_t)(now - last->stamp) > maxGap)
+        r->expired = true;
+    }
+  }
+}
+void spRpmRecord(spRpmHistory_t *h, unsigned m, uint32_t stamp, uint32_t raw) {
+  if (m >= 4)
+    return;
+  spRpmMotor_t *r = &h->motor[m];
+  if (raw > 4000U) {
+    r->invalid++;
+    return;
+  } /* >6981rad/s at6pairs; physical policy lower */
+  if (r->expired) {
+    r->lock++;
+    BARRIER();
+    r->count = 0;
+    r->expired = false;
+    BARRIER();
+    r->lock++;
+  }
+  if (r->count) {
+    const spRpmSample_t *last =
+        &r->sample[(r->head + SP_RPM_HISTORY - 1) % SP_RPM_HISTORY];
+    const int32_t delta = (int32_t)(stamp - last->stamp);
+    if (delta == 0) {
+      r->duplicates++;
+      return;
+    }
+    if (delta < 0) {
+      r->outOfOrder++;
+      return;
+    }
+  }
+  r->lock++;
+  BARRIER();
+  r->sequence++;
+  r->sample[r->head] = (spRpmSample_t){stamp, raw, r->sequence};
+  r->head = (r->head + 1) % SP_RPM_HISTORY;
+  if (r->count < SP_RPM_HISTORY)
+    r->count++;
+  BARRIER();
+  r->lock++;
+}
+bool spRpmSelect(const spRpmHistory_t *h, uint32_t now, uint32_t maxAge,
+                 uint32_t maxSkew, unsigned poles, spRpmSelection_t *out) {
+  const spRpmSelection_t prev = *out;
+  memset(out, 0, sizeof(*out));
+  uint32_t minAge = UINT32_MAX, maxSelectedAge = 0;
+  if (!poles)
+    return false;
+  for (unsigned m = 0; m < 4; m++) {
+    const spRpmMotor_t *r = &h->motor[m];
+    spRpmMotor_t copy;
+    bool stable = false;
+    for (unsigned attempt = 0; attempt < 3; attempt++) {
+      const uint32_t before = r->lock;
+      BARRIER();
+      if (before & 1)
+        continue;
+      memcpy(&copy, r, sizeof(copy));
+      BARRIER();
+      if (before == r->lock) {
+        stable = true;
+        break;
+      }
+    }
+    if (!stable || !copy.count || copy.expired) {
+      out->missingMask |= 1 << m;
+      continue;
+    }
+    bool found = false;
+    for (unsigned j = 0; j < copy.count; j++) {
+      const spRpmSample_t *s =
+          &copy.sample[(copy.head + SP_RPM_HISTORY - 1 - j) % SP_RPM_HISTORY];
+      if ((int32_t)(now - s->stamp) < 0) {
+        out->futureMask |= 1 << m;
+        continue;
+      }
+      out->selected[m] = *s;
+      found = true;
+      break;
+    }
+    if (!found) {
+      out->missingMask |= 1 << m;
+      continue;
+    }
+    const spRpmSample_t *s = &out->selected[m];
+    out->age[m] = now - s->stamp;
+    out->selectedSequence[m] = s->sequence;
+    out->omega[m] = (float)s->raw * (100.0f * 6.2831853071795864769f / 60.0f) /
+                    (float)poles;
+    if (s->sequence != prev.selectedSequence[m])
+      out->newMask |= 1 << m;
+    if (out->age[m] <= maxAge && isfinite(out->omega[m]))
+      out->validMask |= 1 << m;
+    if (out->age[m] < minAge) {
+      minAge = out->age[m];
+    }
+    if (out->age[m] > maxSelectedAge) {
+      maxSelectedAge = out->age[m];
+    }
+  }
+  out->skew = minAge == UINT32_MAX ? UINT32_MAX : maxSelectedAge - minAge;
+  return out->validMask == 15 && out->skew <= maxSkew;
+}
