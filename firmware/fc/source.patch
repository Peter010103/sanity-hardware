diff --git a/src/main/flight/sanity_force.c b/src/main/flight/sanity_force.c
new file mode 100644
index 0000000..7bbef5b
--- /dev/null
+++ b/src/main/flight/sanity_force.c
@@ -0,0 +1,123 @@
+/* Logging-only adapter. No references to motor commands, disarm or control
+ * state: the observer can be evaluated with either PID or INDI selected.
+ * GPL-3.0-or-later.
+ */
+#include "platform.h"
+#ifdef USE_SANITY_INDI
+#include <math.h>
+#include <string.h>
+#include "build/debug.h"
+#include "common/maths.h"
+#include "drivers/dshot.h"
+#include "drivers/motor.h"
+#include "drivers/time.h"
+#include "flight/mixer.h"
+#include "pg/motor.h"
+#include "pg/sanity_force.h"
+#include "sensors/acceleration.h"
+#include "sensors/gyro.h"
+#include "sanity_force.h"
+#include "sanity_indi/model.h"
+
+static FAST_DATA_ZERO_INIT sfState_t observer;
+static sanityForceConfig_t settings;
+static bool configured, configValid;
+
+static bool configure(void)
+{
+    const sanityForceConfig_t *current = sanityForceConfig();
+    const bool supported = getMotorCount() == 4 && motorConfig()->motorPoleCount == 12 &&
+        motorConfig()->dev.useDshotTelemetry && acc.sampleRateHz && acc.dev.acc_1G;
+    if (configured && memcmp(current, &settings, sizeof(settings)) == 0) {
+        if (!current->enabled) return false;
+        if (!supported) { configValid = false; return false; }
+        if (configValid && observer.config.periodUs == 1000000U / acc.sampleRateHz) return true;
+    }
+    settings = *current;
+    configured = true;
+    configValid = false;
+    memset(&observer, 0, sizeof(observer));
+    if (!settings.enabled) return false;
+    if (!supported) return false;
+    sfConfig_t c = {0};
+    c.massKg = SI_MASS_KG;
+    c.maxOmega = 5883.8916304062f; // Maximum speed in the identified speed/thrust dataset.
+    c.cutoffHz = settings.cutoffHz;
+    c.thrustAxis[2] = 1.0f; // Aligned native accelerometer: positive Z is thrust/up at upright hover.
+    c.periodUs = 1000000U / acc.sampleRateHz;
+    c.maxGapUs = 4U * c.periodUs;
+    c.maxAccAgeUs = c.maxGapUs;
+    c.maxRpmAgeUs = settings.rpmMaxAgeUs;
+    c.warmupUs = (uint32_t)settings.warmupMs * 1000U;
+    c.accDelayUs = settings.accDelayUs;
+    c.rpmDelayUs = settings.rpmDelayUs;
+    for (unsigned m = 0; m < 4; ++m) c.kT[m] = SI_KT;
+    for (unsigned a = 0; a < 3; ++a) {
+        c.imuOffsetM[a] = (float)settings.imuOffsetMm[a] * 0.001f;
+        c.accBias[a] = (float)settings.accBiasMg[a] * 0.00980665f;
+    }
+    configValid = sfInit(&observer, &c);
+    return configValid;
+}
+
+void sanityForceRecordErpm(unsigned motor, uint32_t stamp, uint32_t erpm)
+{
+    if (!configured || !configValid || !sanityForceConfig()->enabled) return;
+    // Betaflight stores eRPM in units of 100 electrical RPM, not mechanical RPM.
+    // Pole count is checked against the conversion used by the identified model.
+    const float mechanicalOmega = (float)erpm * 100.0f / 6.0f * (2.0f * M_PIf / 60.0f);
+    sfRecordRpm(&observer, motor, stamp, mechanicalOmega);
+}
+
+void sanityForceSample(uint32_t stamp, const float alignedCounts[3], bool calibrated, bool sourceFresh, uint8_t sourceKind)
+{
+    const uint32_t start = micros();
+    if (!configure()) return;
+    observer.output.sourceKind = sourceKind;
+    if (!sourceFresh) { sfRejectSample(&observer, stamp, SF_ACC_STALE); return; }
+    float measured[3], omega[3];
+    for (unsigned a = 0; a < 3; ++a) {
+        measured[a] = alignedCounts[a] * (9.80665f / (float)acc.dev.acc_1G);
+        omega[a] = DEGREES_TO_RADIANS(gyro.sanityIndiGyro[a]);
+    }
+    sfUpdate(&observer, stamp, measured, omega, calibrated);
+    const uint32_t elapsed = micros() - start;
+    observer.output.lastRuntimeUs = elapsed < UINT16_MAX ? elapsed : UINT16_MAX;
+    if (observer.output.lastRuntimeUs > observer.output.maxRuntimeUs)
+        observer.output.maxRuntimeUs = observer.output.lastRuntimeUs;
+}
+
+sfOutput_t sanityForceSnapshot(uint32_t now)
+{
+    const bool enabled = sanityForceConfig()->enabled;
+    if (!enabled || !configured || !configValid || memcmp(sanityForceConfig(), &settings, sizeof(settings)) != 0) {
+        sfOutput_t out = {0};
+        out.enabled = enabled;
+        out.reason = !enabled ? SF_DISABLED : !configured ? SF_ACC_MISSING : SF_CONFIG;
+        out.exportTimeUs = now;
+        for (unsigned m = 0; m < 4; ++m) out.rpmAgeUs[m] = UINT16_MAX;
+        return out;
+    }
+    return sfSnapshot(&observer, now);
+}
+
+static int16_t debugValue(float value)
+{
+    if (!isfinite(value)) return 0;
+    return (int16_t)lrintf(fminf(32767.0f, fmaxf(-32768.0f, value)));
+}
+
+void sanityForceDebugUpdate(uint32_t now)
+{
+    if (debugMode != DEBUG_SANITY_FORCE) return;
+    const sfOutput_t out = sanityForceSnapshot(now);
+    for (unsigned a = 0; a < 3; ++a) DEBUG_SET(DEBUG_SANITY_FORCE, a, debugValue(out.externalN[a]*1000.0f));
+    DEBUG_SET(DEBUG_SANITY_FORCE, 3, debugValue(out.thrustN*1000.0f));
+    DEBUG_SET(DEBUG_SANITY_FORCE, 4, out.reason);
+    DEBUG_SET(DEBUG_SANITY_FORCE, 5, out.rpmMask);
+    DEBUG_SET(DEBUG_SANITY_FORCE, 6, debugValue((float)out.intervalUs));
+    uint16_t oldest = 0;
+    for (unsigned m = 0; m < 4; ++m) if (out.rpmAgeUs[m] > oldest) oldest = out.rpmAgeUs[m];
+    DEBUG_SET(DEBUG_SANITY_FORCE, 7, debugValue((float)oldest));
+}
+#endif
