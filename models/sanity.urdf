<?xml version="1.0"?>
<!-- SI units. All aircraft mass and inertia are on base_link; rotor links define massless frames. -->
<robot name="sanity">
<link name="base_link">
<inertial>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <mass value="0.06609"/>
  <inertia ixx="0.0000575" ixy="0" ixz="0" iyy="0.0000664" iyz="0" izz="0.0000931"/>
</inertial>
<visual name="material_0"><geometry><mesh filename="meshes/visual/material_0.obj" scale="1 1 1"/></geometry><material name="material_0"><color rgba="0.854306 0.34919 0.34919 1"/></material></visual>
<visual name="material_1"><geometry><mesh filename="meshes/visual/material_1.obj" scale="1 1 1"/></geometry><material name="material_1"><color rgba="0.0998528 0.0998528 0.0998528 1"/></material></visual>
<visual name="material_2"><geometry><mesh filename="meshes/visual/material_2.obj" scale="1 1 1"/></geometry><material name="material_2"><color rgba="0.896244 0.791787 0.618031 1"/></material></visual>
<visual name="material_3"><geometry><mesh filename="meshes/visual/material_3.obj" scale="1 1 1"/></geometry><material name="material_3"><color rgba="0.247059 0.247059 0.247059 1"/></material></visual>
<visual name="material_4"><geometry><mesh filename="meshes/visual/material_4.obj" scale="1 1 1"/></geometry><material name="material_4"><color rgba="0.0998528 0.0998528 0.0998528 1"/></material></visual>
<visual name="material_5"><geometry><mesh filename="meshes/visual/material_5.obj" scale="1 1 1"/></geometry><material name="material_5"><color rgba="0.0998528 0.0998528 0.0998528 1"/></material></visual>
<collision name="conservative_envelope"><geometry><mesh filename="meshes/collision/envelope.obj" scale="1 1 1"/></geometry></collision>
</link>
<link name="rotor_1_rear_right"><inertial><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>
<joint name="rotor_1_frame" type="fixed"><parent link="base_link"/><child link="rotor_1_rear_right"/><origin xyz="-0.0284610479 -0.0284610479 0" rpy="0 0 0"/></joint>
<link name="rotor_2_front_right"><inertial><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>
<joint name="rotor_2_frame" type="fixed"><parent link="base_link"/><child link="rotor_2_front_right"/><origin xyz="0.0284610479 -0.0284610479 0" rpy="0 0 0"/></joint>
<link name="rotor_3_front_left"><inertial><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>
<joint name="rotor_3_frame" type="fixed"><parent link="base_link"/><child link="rotor_3_front_left"/><origin xyz="0.0284610479 0.0284610479 0" rpy="0 0 0"/></joint>
<link name="rotor_4_rear_left"><inertial><mass value="0"/><inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial></link>
<joint name="rotor_4_frame" type="fixed"><parent link="base_link"/><child link="rotor_4_rear_left"/><origin xyz="-0.0284610479 0.0284610479 0" rpy="0 0 0"/></joint>
</robot>
