+  s->weight = policy.weight;
+  s->mode = policy.mode;
+  s->reason = policy.reason;
+  s->fault = policy.fault;
+  s->lastFault = policy.lastFault;
+  s->transitions = policy.transitions;
+  s->fallbacks = policy.fallbacks;
