+ * gyro and acceleration timestamps remain independent through decimation. */
+typedef struct {
+  uint64_t epoch;
+  uint32_t gyro_delay_us, accel_delay_us;
+  uint32_t sequence, gyro_us, accel_us, gyro_uncertainty_us,
